        <Container ID="CivInfo" Size="270,75" Anchor="L,C" Offset="0,0">
          <Image Texture="PlayerRibbon_Backing.dds" Size="68,68" Offset="0,0" Anchor="L,C" >
            <Image ID="LeaderIcon" Anchor="C,C" Size="64,64" />
          </Image>
          <Image ID="RelationshipIndicator" Texture="PlayerRibbon_RelationshipIndicators.dds" Size="88,75" Hidden="0" Anchor="L,T" Offset="1,1" TextureOffset="50,0"/>
          <Stack Anchor="L,T" StackGrowth="Down" Offset="70,5">
            <Label WrapWidth="200" ID="LeaderName" Style="WhiteShadow" String="$LEADER NAME HERE" />
            <Label WrapWidth="205" ID="CivName"  Style="GrayShadow16" String="$CIV NAME HERE"/>
          </Stack>
          <Label ID="Relationship" Offset="70,5" Anchor="L,B" Style="GrayGlow20" String="$RELATIONSHIP" />
