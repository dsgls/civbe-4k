        <Grid ID="AllServicesWindowDropShadow" Style="Grid9DropShadow" Size="990, parent-77" Offset="0,77" Anchor="C,T"/>
        <Grid ID="AllServicesWindow" Style="Grid9DiplomacyWindow" Size="900,parent-77" Offset="0,77" Anchor="C,T">
          <Container Offset="7,1" Size="888,32">
            <Container Size="888,32" Anchor="C,C">
              <Stack ID="AllServicesWindowHeaderStack" StackGrowth="Right" Anchor="L,C" Padding="5">
                <Container Size="33,28" Offset="0,2"/>
                <Label ID="AllServicesWindowHeader" Anchor="L,C" Style="GradientHeader" String="{TXT_KEY_DIPLOMACYUI_ALL_SERVICES:upper}" />
              </Stack>
            </Container>
          </Container>
          <AlphaAnim Size="parent,parent" Anchor="C,C" AlphaStart="0" AlphaEnd="1" Cycle="Once" Speed="3" Function="Root" ID="AllServicesAlpha" >
            <SlideAnim Size="parent,parent" Begin="-10,0" End="0,0" Cycle="Once" Speed="3" Function="Root" ID="AllServicesSlide">
              <Container Size="parent-10,parent-37" Anchor="C,B" Offset="0,5">
                <Grid Size="parent, 35" Style="GridColumnHeader"/>
                <Stack Anchor="C,T" StackGrowth="right" Padding="0">
                  <GridButton ID="SortServicesBySponsor" Style="ColumnHeader" Anchor="C,C" Size="330,35" String="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_SPONSOR" ToolTip="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_SPONSOR_TT"/>
                  <GridButton ID="SortServicesByName" Style="ColumnHeader" Anchor="C,C" Size="300,35" String="TXT_KEY_DIPLO_NAME" ToolTip="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_NAME_TT"/>
                  <GridButton ID="SortServicesByCost" Style="ColumnHeader" Anchor="C,C" Size="100,35" String="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_COST" ToolTip="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_COST_TT"/>
                </Stack>
                <Container Size="parent,parent-35" Anchor="C,T" Offset="0,35"></Container>
                <ScrollPanel ID="AllServicesScrollPanel" Size="parent-120,parent-35" Offset="0,35" Vertical="true" Anchor="R,T">
                  <ScrollBar Style="VertSlider" Anchor="R,T" AnchorSide="O,I" Offset="-16,0"/>
                  <Stack ID="AllServicesStack" StackGrowth="Bottom" Anchor="C,T" Offset="-45,0">
                  </Stack>
                </ScrollPanel>
              </Container>
            </SlideAnim>
          </AlphaAnim>
