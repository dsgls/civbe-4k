          </Stack>
        </Stack>
      </Stack>
      <Stack ID="TimeStampStack" Anchor="R,C" StackGrowth="Down">
        <Box Size="240,50" Color="White,0">
          <Label Style="FontNormal14" Color0="128,144,162,255" Color1="0,0,0,100" FontStyle="Shadow" String="000" ID="StartEraTurns" />
