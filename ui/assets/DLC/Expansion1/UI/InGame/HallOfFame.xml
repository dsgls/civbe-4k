<?xml version="1.0" encoding="utf-8"?>
<Context ColorSet="Beige_Black" Style="FontNormal20" FontStyle="Shadow" >
  
  <!-- GameInstance -->
  <Instance Name="GameInstance" >
    <Grid Size="1990,160" Anchor="L,T" ID="GameItem" Style="CivilopediaListItem">
