        <!-- Your Info -->
        <Box Size="240,parent" Color="White,0">
          <Label Anchor="C,C" Offset="0,0" Style="GrayGlow24" ID="Score"/>
        </Box>
        <Box Size="560,parent" Anchor="L,T" Color="White.0" > 
          <Image ID="CivSymbol" Size="90,90" Offset="0,0" Anchor="L,C" Texture="CivSymbolsColor360.dds" />
