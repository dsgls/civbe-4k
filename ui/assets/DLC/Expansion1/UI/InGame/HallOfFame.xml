        <Box Anchor="L,T" Color="White.0" Size="400,48" Offset="0,0">
          <Label Offset="0,8" Anchor="C,C" Style="GrayGlow" String="{TXT_KEY_HOF_SETTINGS:upper}" />
        </Box>
      </Stack>
    </Grid>
    <Label Anchor="C,C" String="TXT_KEY_HALL_OF_FAME_EMPTY" ID="HallOfFameEmpty" />
    <Grid Style="TabSpacerDark" Size="parent-24,10" Offset="0,30" Anchor="C,B"/>
