<?xml version="1.0" encoding="utf-8"?>
<Context Style="FontNormal18" FontStyle="Shadow" ColorSet="Beige_Black_Alpha">
  <Box ID="BlockerInGame" Style="BGBlock_ClearTopBar"/>
  <Box ID="BlockerDiplo" Style="BGBlock"/>
  <AlphaAnim Size="Full,Full" Cycle="Once" Pause="0" Speed="2" AlphaStart="0" Function="OutQuint" AlphaEnd="1" ID="AlphaAnim">
    <Box Size="Full,Full" Color="0,0,0,0" ConsumeMouse="1" HideBox="0" ID="BGBlock" Hidden="1"/>
    <Grid ID="Grid" Size="2016,1330" Anchor="C,C" Offset="0,0" Style="GridWindowWithHeader" ConsumeMouse="1">
      <Button	ID="CloseButton" Anchor="R,T" Offset="14,14" Style="CloseButton"/>

      <!-- Panel Header -->
      <Label Style="MenuTitleCaption" String="{TXT_KEY_DIPLOMACYUI_SUMMARY:upper}" ID="Title" />

      <!-- Main Content -->
      <Container Offset="0,96" Anchor="C,T" Size="parent,parent-96">
        <!-- Column Headers -->
        <Stack Anchor="L,T" StackGrowth="Right" Offset="16,0" Padding="0">
          <GridButton ID="SortByLeaderButton" Anchor="C,C" Size="844,70" String="{TXT_KEY_DIPLO_SUMMARYUI_LEADER:upper}" ToolTip="TXT_KEY_DIPLO_SUMMARYUI_LEADER_TT" Style="BaseButtonDark" FontSize="24" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100"/>
          <GridButton Anchor="C,C" Size="464,70" String="{TXT_KEY_DIPLO_SUMMARYUI_STATS:upper}" Style="GridColumnHeader" Disabled="true" FontSize="24" FontStyle="glow" Color0="128,144,162,255" Color1="0,0,0,100"/>
          <GridButton ID="SortByScoreButton" Anchor="C,C" Size="144,70" String="{TXT_KEY_DIPLO_SUMMARYUI_SCORE:upper}" ToolTip="TXT_KEY_DIPLO_SUMMARYUI_SCORE_TT" Style="BaseButtonDark" FontSize="24" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100"/>
          <GridButton ID="SortByWondersButton" Anchor="C,C" Size="184,70" String="{TXT_KEY_DIPLO_SUMMARYUI_WONDERS:upper}" ToolTip="TXT_KEY_DIPLO_SUMMARYUI_WONDERS_TT" Style="BaseButtonDark" FontSize="24" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100"/>
          <GridButton Anchor="C,C" Size="346,70" String="{TXT_KEY_DIPLO_SUMMARYUI_AGREEMENTS:upper}" Style="GridColumnHeader" Disabled="true" FontSize="24" FontStyle="glow" Color0="128,144,162,255" Color1="0,0,0,100"/>
        </Stack>
        <!-- Entries -->
        <Container Size="parent,parent-120" Anchor="L,T" Offset="16,70">
          <ScrollPanel ID="ScrollPanel" Vertical="true" Size="parent,parent">
            <Stack ID="EntriesStack" Anchor="L,T" StackGrowth="Bottom" Offset="0,0" Padding="0" />
            <ScrollBar Style="VertSlider" Anchor="R,T" AnchorSide="O,I" Offset="-70,0"/>
          </ScrollPanel>
        </Container>
      </Container>
    </Grid>
  </AlphaAnim>

  <!-- Instances -->
  <Instance Name="Entry">
    <Container ID="Content" Size="1976,140">
      <GridButton ID="Button" Size="parent,parent" Style="BaseButtonDark"/>
      
      <Stack ID="ContentStack" Anchor="C,T" StackGrowth="Right" Offset="0,0" Padding="4" >
        <!-- Leader Info -->
        <Container Anchor="C,C" Size="840,parent">
          <Image Texture="PlayerRibbon_Backing.dds" Size="136,136" Offset="4,0" Anchor="L,C" >
            <Image ID="Icon" Size="128,128" Anchor="C,C"/>
          </Image>
          <Image Texture="PlayerRibbon_RelationshipIndicators.dds" Size="176,150" Hidden="0" Anchor="L,T" Offset="6,-6" ID="RelationshipIndicator" TextureOffset="100,0"/>
          <Image Texture="PlayerRibbon_Talk.dds" Size="66,64" Anchor="L,B" Offset="0,0" Hidden="0" ID="TalkIndicator"/>
          <Stack Anchor="L,T" StackGrowth="Down" Offset="150,10">
            <Label ID="Name" Style="WhiteShadow" String="$LEADER NAME HERE" WrapWidth="420"/>
            <Label ID="CivName"  Style="GrayShadow16" String="$CIV NAME HERE" WrapWidth="420"/>
          </Stack>
          <Label ID="Relationship" Offset="150,10" Anchor="L,B" Style="GrayShadow16" String="$RELATIONSHIP" />
          <Box Color="0,0,0,100" Anchor="R,C" Offset="146,0" Size="128,parent"/>
          <Box Style="CivIcon64" Anchor="R,C" Offset="150,0" />
          <Stack ID="TraitsStack" StackGrowth="Right" WrapGrowth="Bottom" WrapWidth="156" Anchor="R,C" Offset="0,0" Padding="6" />
          <Box AnchorSide="O,I" Anchor="R,T" Offset="6,0" Size="4,parent" Color="0,0,0,255"/>
        </Container>
        <!-- Yields -->
        <Container Anchor="C,C" Size="460,parent">
          <!-- Fear/Respect -->
          <Stack Anchor="C,T" StackGrowth="Right" Offset="0,0" Padding="4">
            <Container Size="140,parent">
              <Stack StackGrowth="Down" Anchor="C,C" Offset="0,0" Padding="4">
                <Grid Anchor="R,T" Style="Grid9YieldBacking" Size="120,36" ID="RespectContainer" Color="255,255,255,200" ToolTip="{TXT_KEY_DIPLO_RESPECTDESC}">
                  <Label String="[ICON_RESPECT]" Anchor="L,B" Offset="4,-2" ID="RespectLabel"/>
                  <Stack StackGrowth="Right" Offset="50,-4" Anchor="L,B">
                    <Label Style="RespectText" FontSize="44" String="99" ID="RespectLVLValue"/>
                    <Label Style="RespectText" FontSize="32" Anchor="L,B" String="99" ID="RespectPossValue"/>
                  </Stack>
                  <Image Texture="Diplo_RespectMeter.dds" Size="14,38" Anchor="R,B" TextureOffset="14,0" Color="200,200,200,255"/>
                  <TextureBar ID="RespectMeter" Texture="Diplo_RespectMeter.dds" TextureOffset="28,0" Size="14,38" Anchor="R,B" Direction="Up"/>
                </Grid>
                <Grid Anchor="R,T" Style="Grid9YieldBacking" Size="120,36" ID="FearContainer" Color="255,255,255,200" ToolTip="{TXT_KEY_DIPLO_FEARDESC}">
                  <Label String="[ICON_FEAR]" Anchor="L,B" Offset="4,-2" ID="FearLabel"/>
                  <Stack StackGrowth="Right" Offset="50,-4" Anchor="L,B">
                    <Label Style="FearText" FontSize="44" String="99" ID="FearLVLValue"/>
                    <Label Style="FearText" FontSize="32" Anchor="L,B" String="99" ID="FearPossValue"/>
                  </Stack>
                  <Image Texture="Diplo_FearMeter.dds" Size="14,38" Anchor="R,B" TextureOffset="14,0" Color="200,200,200,255"/>
                  <TextureBar ID="FearMeter" Texture="Diplo_FearMeter.dds" TextureOffset="28,0" Size="14,38" Anchor="R,B" Direction="Up"/>
                </Grid>
              </Stack>
              <Box AnchorSide="O,I" Anchor="R,T" Offset="6,0" Size="4,parent" Color="0,0,0,255"/>
            </Container>
            <!-- Affinity -->
            <Container Size="100,parent">
              <Stack Anchor="C,C" StackGrowth="Bottom" Padding="0">
                <Label ID="HarmonyAffinity" String="[ICON_HARMONY]99" Style="HarmonyText" ToolTip="TXT_KEY_AFFINITY_DESCRIPTION_HARMONY"/>
                <Label ID="PurityAffinity" String="[ICON_PURITY]99" Style="PurityText" ToolTip="TXT_KEY_AFFINITY_DESCRIPTION_PURITY"/>
                <Label ID="SupremacyAffinity" String="[ICON_SUPREMACY]99" Style="SupremacyText" ToolTip="TXT_KEY_AFFINITY_DESCRIPTION_SUPREMACY"/>
              </Stack>
              <Box AnchorSide="O,I" Anchor="R,T" Offset="6,0" Size="4,parent" Color="0,0,0,255"/>
            </Container>
            <!-- Capital -->
            <Container Size="210,parent">
              <Label ID="Capital" Anchor="C,C" String="[ICON_DIPLO_CAPITAL]9999(+99)" Style="DiploCapitalText20" ToolTip="TXT_KEY_TP_DIPLO_CAPITAL_EXPLANATION"/>
              <Box AnchorSide="O,I" Anchor="R,T" Offset="6,0" Size="4,parent" Color="0,0,0,255"/>
            </Container>
          </Stack>
        </Container>
        <!-- Score -->
        <Container Anchor="C,C" Size="140,parent">
          <Image ID="Rank" Texture="Agreements_Numbers.dds" Size="120,112" Anchor="L,B" Offset="6,2" Color="255,255,255,200"/>
          <Label ID="Score" Anchor="C,C" String="999" Style="GradientHeader"/>
          <Box AnchorSide="O,I" Anchor="R,T" Offset="6,0" Size="4,parent" Color="0,0,0,255"/>
        </Container>
        <!-- Wonders -->
        <Container ID="WondersContainer" Anchor="C,C" Size="184,parent">
          <Image Texture="Summary_WondersBacking.dds" Size="100,100" Anchor="C,C"/>
          <Label ID="Wonders" Anchor="C,C" String="99" Style="GradientHeader"/>
          <Box AnchorSide="O,I" Anchor="R,T" Offset="6,0" Size="4,parent" Color="0,0,0,255"/>
        </Container>
        <!-- Agreements -->
        <Container Anchor="C,C" Size="346,parent">
          <Label ID="NoAgreements" Anchor="C,C" Style="GrayShadow16" String="{TXT_KEY_DIPLO_SUMMARYUI_NO_AGREEMENTS:upper}" />
          <Stack ID="AgreementsStack" Anchor="R,C" Offset="6,14" StackGrowth="Right" Padding="0" />
        </Container>
      </Stack>
