<?xml version="1.0" encoding="utf-8"?>
<Context Style="FontNormal18" FontStyle="Shadow" ColorSet="Beige_Black_Alpha">
  <Box Style="BGBlock_ClearTopBar"/>
  <AlphaAnim Size="Full,Full" Cycle="Once" Pause="0" Speed="2" AlphaStart="0" Function="OutQuint" AlphaEnd="1" ID="AlphaAnim">
    <Box Size="Full,Full" Color="0,0,0,0" ConsumeMouse="1" HideBox="0" ID="BGBlock" Hidden="1"/>
    <Grid Size="2000, 1280"					Anchor="C,C" Offset="0,0"	Style="GridWindowWithHeader" ConsumeMouse="1">

      <!-- Close Button -->
      <Button	ID="CloseButton"			Anchor="R,T" Offset="14,14"	Style="CloseButton"/>
      <!-- Title -->
      <Label  Style="MenuTitleCaption" String="{TXT_KEY_ARTIFACTS_OVERVIEW:upper}" ID="Title" />

      <!-- Main content -->
      <Container ID="EarnedYields" Anchor="L,T" Offset="24,112" Size="400,Parent-164">
        <Image Anchor="L,T" Offset="400,0" Color="255,255,255,100" Texture="SideRight.dds" Size="26,1120"/>
        <Label ID="EarnedYieldsTitle" Anchor="C,T" Style="GrayGlow22" Offset="0,8" String="{TXT_KEY_ARTIFACTS_OVERVIEW_EARNED_YIELDS:upper}"/>
        <Stack ID="EarnedYieldsStack" Anchor="L,T" Size="Parent,Parent-48" Offset="24,96" StackGrowth="B" Padding="16">
          <Label ID="EarnedEnergy" Style="WhiteShadow22" String="TXT_KEY_YIELD_ENERGY" />
          <Label ID="EarnedFood" Style="WhiteShadow22" String="TXT_KEY_YIELD_FOOD" />
          <Label ID="EarnedProduction" Style="WhiteShadow22" String="TXT_KEY_YIELD_PRODUCTION" />
          <Label ID="EarnedScience" Style="WhiteShadow22" String="TXT_KEY_YIELD_SCIENCE" />
          <Label ID="EarnedCulture" Style="WhiteShadow22" String="TXT_KEY_YIELD_CULTURE" />          
        </Stack>
        <Image Anchor="C,T" Offset="-4,60" TextureOffset="110.0" Texture="bar300x2.dds" Size="380.2" Color="255,255,255,150"/>
      </Container>

      <Container ID="EarnedItems" Anchor="R,T" Offset="24,112"	Size="1520,Parent-164">
        <Label ID="EarnedItemsTitle" Style="GrayGlow22" Anchor="C,T" Offset="0,8" String="{TXT_KEY_ARTIFACTS_OVERVIEW_EARNED_ITEMS:upper}"/>
        
        <ScrollPanel ID="EarnedItemsScrollPanel" Anchor="L,T" Offset="0,56" Size="Parent,Parent-56"	Vertical="1" ConsumeMouse="1" >
          <ScrollBar ID="EarnedItemsScrollBar"		Anchor="R,T" Offset="0,0"		Length="Parent"			Style="VertSlider" AnchorSide="I,I" />
          <Stack ID="EarnedItemsStack" Anchor="L,T" Offset="0,0"		Size="Parent,Parent"		StackGrowth="B" Padding="4">
            <GridButton	ID="PerksButton" Anchor="L,T" Offset="2,0"	Size="Parent-40,54" Style="ProductionCategoryBackground">
              <Label ID="PerksHeader" Anchor="L,T" Offset="10,8" Style="ProductionListHeaderText" String="{TXT_KEY_ARTIFACTS_OVERVIEW_ABILITIES:upper}"/>
              <Label	ID="PerksPlus" Anchor="R,C" Offset="4,0"	Style="ProductionListHeaderText" String="+"/>
            </GridButton>
            <Stack ID="PerksStack" Anchor="L,T" StackGrowth="B" Padding="4"/>
            <GridButton	ID="BuildingsButton" Anchor="L,T" Offset="2,0"	Size="Parent-40,54" Style="ProductionCategoryBackground">
              <Label ID="BuildingsHeader" Anchor="L,T" Offset="10,8" Style="ProductionListHeaderText" String="{TXT_KEY_POP_BUILDINGS:upper}"/>
              <Label	ID="BuildingsPlus" Anchor="R,C" Offset="4,0"	Style="ProductionListHeaderText" String="+"/>
            </GridButton>
            <Stack ID="BuildingsStack" Anchor="L,T" StackGrowth="B" Padding="4"/>          
            <GridButton	ID="WondersButton" Anchor="L,T" Offset="2,0"	Size="Parent-40,54" Style="ProductionCategoryBackground">
              <Label ID="WondersHeader" Anchor="L,T" Offset="10,8" Style="ProductionListHeaderText" String="{TXT_KEY_POP_WONDERS:upper}"/>
              <Label	ID="WondersPlus" Anchor="R,C" Offset="4,0"	Style="ProductionListHeaderText" String="+"/>
            </GridButton>
            <Stack ID="WondersStack" Anchor="L,T" StackGrowth="B" Padding="4"/>
          </Stack>
        </ScrollPanel>
      </Container>      
    </Grid>
  </AlphaAnim>

  <!-- INSTANCES -->

  <Instance Name="PerkInstance">
    <Grid ID="Header"	Size="1480,120"	Style="GridSecondaryPanelHeader">
      <Label ID="Title" Anchor="L,T" Offset="24,8" Style="FontNormal16" Color="0,255,255,255" String="Earned Perk!" />
      <Label ID="Effects" Anchor="L,T" Offset="24,48" Style="ProductionListText" WrapWidth="1480"/>
    </Grid>
  </Instance>

  <Instance Name="BuildingInstance">
    <Grid ID="Header"	Size="1480,136"	Style="GridSecondaryPanelHeader">
      <Image ID="BuildingImage"	Anchor="L,C" Offset="0,8" Size="128,128"	Color="CityView_Icons" Texture="WonderAtlas512.dds"/>
      <Label ID="Title" Anchor="L,T" Offset="140,8" Style="WhiteShadow" String="Earned Building!" />
      <Label ID="Effects" Anchor="L,T" Offset="140,48" Style="ProductionListText" WrapWidth="1480"/>
    </Grid>
  </Instance>

  <Instance Name="NoneInstance">
    <Grid			ID="None"		Offset="0,0"	Size="1480,60" Style="GridSecondaryPanelHeader">
      <Label Style="GrayShadow" Anchor="C,C"	String="{TXT_KEY_COVERT_NONE:upper}" />
    </Grid>
  </Instance>
</Context>
