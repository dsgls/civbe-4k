<?xml version="1.0" encoding="utf-8"?>
<Context Layer="Modal" >

  <Box Style="BGBlock_ClearTopBar"/>

  <AlphaAnim Size="Full,Full" Cycle="Once" Pause="0" Speed="2" AlphaStart="0" Function="OutQuint" AlphaEnd="1" ID="AlphaAnim">
    <Grid ID="Popup" Anchor="C,C" Offset="0,-60"	Size="1200,600" Style="GridWindowWithHeader" >
      <!-- Header -->
      <Label ID="TitleText"	Offset="0,34" Anchor="C,U" String="TXT_KEY_QUEST_OBJECTIVE_RECEIVED_OTHER_POPUP_TITLE" Style="MenuTitleCaption"  />
      
      <!-- Image -->
      <Image ID="Banner" Size="1170,250" Anchor="C,T" Offset="0,96" Texture="Popup_Image_Quest.dds"/>

      <!-- Quest header -->
      <Label ID="QuestName" Style="GrayGlow24" Anchor="L,T" Offset="40,280" Align="Right" String="QUEST NAME HERE" />

      <!-- Content stack -->
      <Stack ID="TextStack"		Anchor="C,T" Offset="0,380" Padding="40">

        <ScrollPanel ID="EpilogueScrollPanel" Anchor="R,T"	Offset="0,0" Size="1172,280" Vertical="1" AutoScrollBar="1">
          <Stack ID="EpilogueStack" StackGrowth="Down" Anchor="C,T" Padding="0" Offset="0,0">
            <Label ID="EpilogueText" Anchor="C,T" String="Epilogue" Style="GrayGlow20" WrapWidth="1080" WrapGrowth="Bottom" />
          </Stack>
          <ScrollBar Anchor="R,T" Style="VertSlider" />
        </ScrollPanel>

        <Image Anchor="C,C" Offset="0,0"  Color="255,255,255,150" Texture="bar500x2.dds" Size="1000.2" />
        <Stack ID="ObjectiveStack" Anchor="C,T" Padding="20" />
      </Stack>

      <Button ID="CloseButton" Anchor="R,T" Offset="0,12" Style="CloseButton" ConsumeMouse="1" Hidden="1" />
      <GridButton ID="ConfirmButton" Anchor="C,B" Offset="0,40"	Size="440,70"	Style="BaseButton" String="TXT_KEY_OK_BUTTON" />
    </Grid>
  </AlphaAnim>

  <!-- Objective Entry -->
  <Instance	 Name="ObjectiveInstance">
    <Container ID="Content" Offset="0,0" Size="1130,40">
      <Stack Anchor="C,C" Padding="20" StackGrowth="Right">
        <Image ID="ActiveCheckBox" Anchor="C,C"	Offset="0,0"	Size="64,64" Style="QuestCheckButtons"  />
        <Label ID="Objective" Anchor="C,C" Offset="0,0"	Style="QuestCompleteText" WrapWidth="920" />
      </Stack>
    </Container>
  </Instance>

</Context>