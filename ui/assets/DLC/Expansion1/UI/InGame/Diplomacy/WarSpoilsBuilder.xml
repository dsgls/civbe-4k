        <Container Size="225,45" Anchor="L,T" Offset="70,38">
          <Image		ID="IconUnderlay1"					Anchor="L,C"	Offset="0,0"	Size="45,45"	Alpha="0.7" Hidden="0" />
          <Image		ID="IconUnderlay2"					Anchor="L,C"	Offset="45,0"	Size="45,45"  Alpha="0.7" Hidden="0" />
          <Image		ID="IconUnderlay3"					Anchor="L,C"	Offset="90,0"	Size="45,45"  Alpha="0.7" Hidden="0" />
          <Image		ID="IconUnderlay4"					Anchor="L,C"	Offset="135,0"	Size="45,45"  Alpha="0.7" Hidden="0" />
          <Image		ID="IconUnderlay5"					Anchor="L,C"	Offset="180,0"	Size="45,45"  Alpha="0.7" Hidden="0" />
          <Button		ID="B1" NoStateChange="1"   Anchor="L,C"	Offset="0,0"	Size="45,45"	Alpha="0.8" ConsumeMouse="0" />
          <Button		ID="B2" NoStateChange="1"   Anchor="L,C"	Offset="45,0"	Size="45,45"  Alpha="0.8" ConsumeMouse="0" />
          <Button		ID="B3" NoStateChange="1"   Anchor="L,C"	Offset="90,0"	Size="45,45"  Alpha="0.8" ConsumeMouse="0" />
          <Button		ID="B4" NoStateChange="1"   Anchor="L,C"	Offset="135,0"	Size="45,45"  Alpha="0.8" ConsumeMouse="0" />
          <Button		ID="B5" NoStateChange="1"   Anchor="L,C"	Offset="180,0"	Size="45,45"  Alpha="0.8" ConsumeMouse="0" />
        </Container>
      </GridButton>
    </Container>
  </Instance>

