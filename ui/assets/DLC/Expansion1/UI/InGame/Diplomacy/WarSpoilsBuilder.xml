        <Image ID="Check" Texture="QuestActive_Checkmark.dds" Size="32,32" Anchor="R,T" Offset="0,0" />
        <Container Size="210,35" Anchor="L,T" Offset="70,3">
          <Label ID="Name" Anchor="L,C" Offset="0,0" WrapWidth="210" Style="WhiteShadow" FontSize="17" String="$TECH NAME HERE$" />
