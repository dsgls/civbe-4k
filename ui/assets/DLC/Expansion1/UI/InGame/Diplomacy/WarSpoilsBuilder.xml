<?xml version="1.0" encoding="utf-8"?>
<Context Style="FontNormal18" FontStyle="Shadow" ColorSet="Gray_Black_Alpha">
  <Box ID="SelectSpoils" Size="parent,parent" ConsumeMouse="1" Color="0,0,0,200">
    <AlphaAnim ID="SelectSpoilsAlphaAnim" Anchor="C,T" Size="parent,parent" AlphaStart="0" AlphaEnd="1" Cycle="Once" Speed="3" Function="Root" ID="SpoilsAlpha">
      <SlideAnim ID="SelectSpoilsSlideAnim" Begin="0,-50" Size="parent,parent" End="0,0" Cycle="Once" Speed="3" Function="Root" ID="SpoilsSlide">
        <Grid Style="Grid9DiplomacyWindow" Size="900,700" Anchor="C,C" Offset="0,20" ID="SpoilsWindow">
          <Label Style="GradientHeader" Anchor="C,T" Offset="0,8" String="{TXT_KEY_WAR_SPOILS:upper}" />
          <Stack Anchor="C,T" Offset="0,34" StackGrowth="Bottom" Padding="0">
            <Container Anchor="C,T" Size="parent,125">
              <Image Texture="DiploWarSpoils_N_Defeat_888x125.dds" Size="888,125" Anchor="C,T"/>
              <Grid ID="HelpBox" Style="GridWindowNoHeader" Size="830,80" Anchor="C,C" Color="255,255,255,200">
                <Label ID="Help" Style="WhiteShadow" FontSize="16" Anchor="C,C" Offset="0,0" WrapWidth="800" String="TXT_KEY_WAR_SPOILS_WINNER_HELP" />
              </Grid>
            </Container>

            <!-- Spoils Selection -->
            <Container Anchor="C,T" Size="parent,410">
              <Stack Anchor="C,T" Offset="0,0" StackGrowth="Right" Padding="0">
                <!-- Tech -->
                <Container Size="375,parent">
                  <Label ID="TechLabel" Style="WhiteShadow" FontSize="22" Anchor="C,T" Offset="0,10" String="$Your Tech" />
                  <Grid Style="Grid9BlackGradientContainer" Size="parent,parent-50" Anchor="L,T" Offset="0,40">
                    <ScrollPanel ID="TechScrollPanel" Size="parent-6,parent-8" Anchor="C,T" Offset="0,2" Vertical="true" AutoScrollBar="1">
                      <ScrollBar Style="VertSlider" Anchor="R,T"/>
                      <Stack ID="TechStack" StackGrowth="Bottom" Anchor="L,T" Padding="3"/>
                    </ScrollPanel>
                  </Grid>
                </Container>

                <!-- Cities -->
                <Container Size="301,parent">
                  <Label ID="CitiesLabel" Style="WhiteShadow" FontSize="22" Anchor="C,T" Offset="0,10" String="$Your Cities" />
                  <Grid Style="Grid9BlackGradientContainer" Size="parent,parent-50" Anchor="L,T" Offset="0,40">
                    <ScrollPanel ID="CityScrollPanel" Size="parent-6,parent-8" Anchor="C,T" Offset="0,2" Vertical="true" AutoScrollBar="1">
                      <ScrollBar Style="VertSlider" Anchor="R,T"/>
                      <Stack ID="CityStack" StackGrowth="Bottom" Anchor="L,T" Padding="3"/>
                    </ScrollPanel>
                  </Grid>
                </Container>

                <!-- Yields -->
                <Container Size="200,parent">
                  <Label ID="YieldsLabel" Style="WhiteShadow" FontSize="22" Anchor="C,T" Offset="0,10" String="$Your Yields" />
                  <Stack StackGrowth="Bottom" Anchor="C,T" Padding="10" Offset="0,40">
                    <Grid Style="Grid9BlackGradientContainer" Size="parent,125">
                      <Stack StackGrowth="Bottom" Anchor="C,C" Padding="10">
                        <Label ID="EnergyLabel" Style="WhiteShadow" FontSize="16" Anchor="L,C" String="$Energy: " />
                        <Stack StackGrowth="Right" Anchor="L,T" Padding="5">
                          <Grid Offset="0,0" Anchor="L,T" Size="parent-100,28" Padding="0,0" Style="ShellTextEditBackground">
                            <EditBox ID="EnergyEditbox" CallOnChar="1" CursorColor="62,75,95,255" HighlightColor="26,42,80,255"  Anchor="L,C" Offset="10,0" Size="parent-20,22" Style="FontNormal18" FontStyle="Shadow" Color0="182,203,228,255" Color1="0,0,0,160" NumberInput="1" MaxLength="3"/>
                          </Grid>
                          <Label Style="WhiteShadow" FontSize="22" Anchor="C,C" Offset="0,0" String="X"/>
                          <Grid Size="30,23" Style="Grid9YieldBacking" Anchor="C,C" Offset="0,0">
                            <Label ID="EnergyWarScore" Anchor="C,C" Style="GradientHeader" String="99" />
                          </Grid>
                        </Stack>
                        
                        <GridButton ID="MaxEnergyButton" Style="BaseButton" Size="125,30" Anchor="C,C" String="TXT_KEY_PEACE_MAX_RESOURCE" />
                      </Stack>
                    </Grid>
                    <Grid Style="Grid9BlackGradientContainer" Size="parent,125">
                      <Stack StackGrowth="Bottom" Anchor="C,C" Padding="10">
                        <Label ID="CapitalLabel" Style="WhiteShadow" FontSize="16" Anchor="L,C" String="$Capital: " />
                        <Stack StackGrowth="Right" Anchor="L,T" Padding="5">
                          <Grid Offset="0,0" Anchor="L,T" Size="parent-100,28" Padding="0,0" Style="ShellTextEditBackground">
                            <EditBox ID="CapitalEditbox" CallOnChar="1" CursorColor="62,75,95,255" HighlightColor="26,42,80,255"  Anchor="L,C" Offset="10,0" Size="parent-20,22" Style="FontNormal18" FontStyle="Shadow" Color0="182,203,228,255" Color1="0,0,0,160" NumberInput="1" MaxLength="3"/>
                          </Grid>
                          <Label Style="WhiteShadow" FontSize="22" Anchor="C,C" Offset="0,0" String="X"/>
                          <Grid Size="30,23" Style="Grid9YieldBacking" Anchor="C,C" Offset="0,0">
                            <Label ID="CapitalWarScore" Anchor="C,C" Style="GradientHeader" String="99" />
                          </Grid>
                        </Stack>
                        <GridButton ID="MaxCapitalButton" Style="BaseButton" Size="125,30" Anchor="C,C" String="TXT_KEY_PEACE_MAX_RESOURCE" />
                      </Stack>
                    </Grid>
                  </Stack>
                </Container>
              </Stack>
            </Container>
            
            <!-- Score -->
            <Grid Style="GridWindowNoHeader" Size="325,68" Anchor="C,T">
              <Stack StackGrowth="Right" Anchor="C,C" Offset="0,0">
                <Container Size="65,25" Anchor="C,C">
                  <Label ID="ScoreCommitted" Style="WhiteShadow" FontSize="20" Anchor="R,C" Offset="10,0" String="0/0"/>
                </Container>
                <Grid	ID="ProgressBar"	Size="164,25" Offset="0,0"	Anchor="C,C"	Style="Callout">
                  <Image  ID="BarEmpty"		Anchor="L,T"	Offset="4,4"	Size="155,16"	Texture="Assets/UI/Art/Controls/ProgressBarCovertOpBG.dds" />
                  <Image  ID="BarCurrent"		Anchor="L,T"	Offset="4,4"	Size="155,16"	Texture="Assets/UI/Art/Controls/ProgressBarCovertOpCurrent.dds" />
                </Grid>
              </Stack>
            </Grid>
          </Stack>

          <!-- Confirm and Cancel -->
          <Stack StackGrowth="Right" Anchor="C,B" Padding="10" Offset="0,6">
            <GridButton ID="CancelSpoilsButton" Style="BaseButton" Size="250,32" String="{TXT_KEY_CANCEL_BUTTON:upper}" />
            <GridButton ID="ConfirmSpoilsButton" Style="BaseButton" Size="250,32" String="{TXT_KEY_UNIT_UPGRADE_CONFIRM:upper}" />
          </Stack>
        </Grid>
      </SlideAnim>
    </AlphaAnim>
  </Box>

  <!-- Instances -->
