<?xml version="1.0" encoding="utf-8"?>
<Context Style="FontNormal18" FontStyle="Shadow" ColorSet="Gray_Black_Alpha">
  <Box ID="SelectSpoils" Size="parent,parent" ConsumeMouse="1" Color="0,0,0,200">
    <AlphaAnim ID="SelectSpoilsAlphaAnim" Anchor="C,T" Size="parent,parent" AlphaStart="0" AlphaEnd="1" Cycle="Once" Speed="3" Function="Root" ID="SpoilsAlpha">
      <SlideAnim ID="SelectSpoilsSlideAnim" Begin="0,-50" Size="parent,parent" End="0,0" Cycle="Once" Speed="3" Function="Root" ID="SpoilsSlide">
        <Grid Style="Grid9DiplomacyWindow" Size="1800,1400" Anchor="C,C" Offset="0,40" ID="SpoilsWindow">
          <Label Style="GradientHeader" Anchor="C,T" Offset="0,16" String="{TXT_KEY_WAR_SPOILS:upper}" />
          <Stack Anchor="C,T" Offset="0,68" StackGrowth="Bottom" Padding="0">
            <Container Anchor="C,T" Size="parent,250">
              <Image Texture="DiploWarSpoils_N_Defeat_888x125.dds" Size="1776,250" Anchor="C,T"/>
              <Grid ID="HelpBox" Style="GridWindowNoHeader" Size="1660,160" Anchor="C,C" Color="255,255,255,200">
                <Label ID="Help" Style="WhiteShadow" FontSize="32" Anchor="C,C" Offset="0,0" WrapWidth="1600" String="TXT_KEY_WAR_SPOILS_WINNER_HELP" />
              </Grid>
            </Container>

            <!-- Spoils Selection -->
            <Container Anchor="C,T" Size="parent,820">
              <Stack Anchor="C,T" Offset="0,0" StackGrowth="Right" Padding="0">
                <!-- Tech -->
                <Container Size="750,parent">
                  <Label ID="TechLabel" Style="WhiteShadow" FontSize="44" Anchor="C,T" Offset="0,20" String="$Your Tech" />
                  <Grid Style="Grid9BlackGradientContainer" Size="parent,parent-100" Anchor="L,T" Offset="0,80">
                    <ScrollPanel ID="TechScrollPanel" Size="parent-12,parent-16" Anchor="C,T" Offset="0,4" Vertical="true" AutoScrollBar="1">
                      <ScrollBar Style="VertSlider" Anchor="R,T"/>
                      <Stack ID="TechStack" StackGrowth="Bottom" Anchor="L,T" Padding="6"/>
                    </ScrollPanel>
                  </Grid>
                </Container>

                <!-- Cities -->
                <Container Size="602,parent">
                  <Label ID="CitiesLabel" Style="WhiteShadow" FontSize="44" Anchor="C,T" Offset="0,20" String="$Your Cities" />
                  <Grid Style="Grid9BlackGradientContainer" Size="parent,parent-100" Anchor="L,T" Offset="0,80">
                    <ScrollPanel ID="CityScrollPanel" Size="parent-12,parent-16" Anchor="C,T" Offset="0,4" Vertical="true" AutoScrollBar="1">
                      <ScrollBar Style="VertSlider" Anchor="R,T"/>
                      <Stack ID="CityStack" StackGrowth="Bottom" Anchor="L,T" Padding="6"/>
                    </ScrollPanel>
                  </Grid>
                </Container>

                <!-- Yields -->
                <Container Size="400,parent">
                  <Label ID="YieldsLabel" Style="WhiteShadow" FontSize="44" Anchor="C,T" Offset="0,20" String="$Your Yields" />
                  <Stack StackGrowth="Bottom" Anchor="C,T" Padding="20" Offset="0,80">
                    <Grid Style="Grid9BlackGradientContainer" Size="parent,250">
                      <Stack StackGrowth="Bottom" Anchor="C,C" Padding="20">
                        <Label ID="EnergyLabel" Style="WhiteShadow" FontSize="32" Anchor="L,C" String="$Energy: " />
                        <Stack StackGrowth="Right" Anchor="L,T" Padding="10">
                          <Grid Offset="0,0" Anchor="L,T" Size="parent-200,56" Padding="0,0" Style="ShellTextEditBackground">
                            <EditBox ID="EnergyEditbox" CallOnChar="1" CursorColor="62,75,95,255" HighlightColor="26,42,80,255"  Anchor="L,C" Offset="20,0" Size="parent-40,44" Style="FontNormal18" FontStyle="Shadow" Color0="182,203,228,255" Color1="0,0,0,160" NumberInput="1" MaxLength="3"/>
                          </Grid>
                          <Label Style="WhiteShadow" FontSize="44" Anchor="C,C" Offset="0,0" String="X"/>
                          <Grid Size="60,46" Style="Grid9YieldBacking" Anchor="C,C" Offset="0,0">
                            <Label ID="EnergyWarScore" Anchor="C,C" Style="GradientHeader" String="99" />
                          </Grid>
                        </Stack>
                        
                        <GridButton ID="MaxEnergyButton" Style="BaseButton" Size="250,60" Anchor="C,C" String="TXT_KEY_PEACE_MAX_RESOURCE" />
                      </Stack>
                    </Grid>
                    <Grid Style="Grid9BlackGradientContainer" Size="parent,250">
                      <Stack StackGrowth="Bottom" Anchor="C,C" Padding="20">
                        <Label ID="CapitalLabel" Style="WhiteShadow" FontSize="32" Anchor="L,C" String="$Capital: " />
                        <Stack StackGrowth="Right" Anchor="L,T" Padding="10">
                          <Grid Offset="0,0" Anchor="L,T" Size="parent-200,56" Padding="0,0" Style="ShellTextEditBackground">
                            <EditBox ID="CapitalEditbox" CallOnChar="1" CursorColor="62,75,95,255" HighlightColor="26,42,80,255"  Anchor="L,C" Offset="20,0" Size="parent-40,44" Style="FontNormal18" FontStyle="Shadow" Color0="182,203,228,255" Color1="0,0,0,160" NumberInput="1" MaxLength="3"/>
                          </Grid>
                          <Label Style="WhiteShadow" FontSize="44" Anchor="C,C" Offset="0,0" String="X"/>
                          <Grid Size="60,46" Style="Grid9YieldBacking" Anchor="C,C" Offset="0,0">
                            <Label ID="CapitalWarScore" Anchor="C,C" Style="GradientHeader" String="99" />
                          </Grid>
                        </Stack>
                        <GridButton ID="MaxCapitalButton" Style="BaseButton" Size="250,60" Anchor="C,C" String="TXT_KEY_PEACE_MAX_RESOURCE" />
                      </Stack>
                    </Grid>
                  </Stack>
                </Container>
              </Stack>
            </Container>
            
            <!-- Score -->
            <Grid Style="GridWindowNoHeader" Size="650,136" Anchor="C,T">
              <Stack StackGrowth="Right" Anchor="C,C" Offset="0,0">
                <Container Size="130,50" Anchor="C,C">
                  <Label ID="ScoreCommitted" Style="WhiteShadow" FontSize="40" Anchor="R,C" Offset="20,0" String="0/0"/>
                </Container>
                <Grid	ID="ProgressBar"	Size="328,50" Offset="0,0"	Anchor="C,C"	Style="Callout">
                  <Image  ID="BarEmpty"		Anchor="L,T"	Offset="8,8"	Size="310,32"	Texture="Assets/UI/Art/Controls/ProgressBarCovertOpBG.dds" />
                  <Image  ID="BarCurrent"		Anchor="L,T"	Offset="8,8"	Size="310,32"	Texture="Assets/UI/Art/Controls/ProgressBarCovertOpCurrent.dds" />
                </Grid>
              </Stack>
            </Grid>
          </Stack>

          <!-- Confirm and Cancel -->
          <Stack StackGrowth="Right" Anchor="C,B" Padding="20" Offset="0,12">
            <GridButton ID="CancelSpoilsButton" Style="BaseButton" Size="500,64" String="{TXT_KEY_CANCEL_BUTTON:upper}" />
            <GridButton ID="ConfirmSpoilsButton" Style="BaseButton" Size="500,64" String="{TXT_KEY_UNIT_UPGRADE_CONFIRM:upper}" />
          </Stack>
        </Grid>
      </SlideAnim>
    </AlphaAnim>
  </Box>

  <!-- Instances -->
  <Instance Name="TechItem">
