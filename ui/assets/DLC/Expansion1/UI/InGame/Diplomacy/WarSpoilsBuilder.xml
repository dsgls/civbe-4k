          <Image ID="AffinityRing" Size="92,92" Texture="TechIconAffinity138.dds" Offset="18,18" />
        </Container>
        <Grid Size="90,46" Style="Grid9YieldBacking" Anchor="R,T" Offset="60,10">
          <Label ID="WarScore" Anchor="C,C" Style="GradientHeader" String="999" />
        </Grid>
        <Image Texture="QuestActive_Checkbox.dds" Size="64,64" Anchor="R,T" Offset="0,0" />
        <Image ID="CheckBoxDisabled" Texture="Checkbox_Gray.dds" Size="64,64" Anchor="R,T" Offset="0,0" />
        <Image ID="Check" Texture="QuestActive_Checkmark.dds" Size="64,64" Anchor="R,T" Offset="0,0" />
        <Container Size="420,70" Anchor="L,T" Offset="140,6">
          <Label ID="Name" Anchor="L,C" Offset="0,0" WrapWidth="420" Style="WhiteShadow" FontSize="34" String="$TECH NAME HERE$" />
        </Container>
        <Container Size="450,90" Anchor="L,T" Offset="140,76">
          <Image		ID="IconUnderlay1"					Anchor="L,C"	Offset="0,0"	Size="90,90"	Alpha="0.7" Hidden="0" />
          <Image		ID="IconUnderlay2"					Anchor="L,C"	Offset="90,0"	Size="90,90"  Alpha="0.7" Hidden="0" />
          <Image		ID="IconUnderlay3"					Anchor="L,C"	Offset="180,0"	Size="90,90"  Alpha="0.7" Hidden="0" />
          <Image		ID="IconUnderlay4"					Anchor="L,C"	Offset="270,0"	Size="90,90"  Alpha="0.7" Hidden="0" />
          <Image		ID="IconUnderlay5"					Anchor="L,C"	Offset="360,0"	Size="90,90"  Alpha="0.7" Hidden="0" />
          <Button		ID="B1" NoStateChange="1"   Anchor="L,C"	Offset="0,0"	Size="90,90"	Alpha="0.8" ConsumeMouse="0" />
          <Button		ID="B2" NoStateChange="1"   Anchor="L,C"	Offset="90,0"	Size="90,90"  Alpha="0.8" ConsumeMouse="0" />
          <Button		ID="B3" NoStateChange="1"   Anchor="L,C"	Offset="180,0"	Size="90,90"  Alpha="0.8" ConsumeMouse="0" />
          <Button		ID="B4" NoStateChange="1"   Anchor="L,C"	Offset="270,0"	Size="90,90"  Alpha="0.8" ConsumeMouse="0" />
          <Button		ID="B5" NoStateChange="1"   Anchor="L,C"	Offset="360,0"	Size="90,90"  Alpha="0.8" ConsumeMouse="0" />
        </Container>
      </GridButton>
    </Container>
  </Instance>

  <Instance Name="CityItem">
    <Container ID="Content" Size="558,120">
      <GridButton ID="Button" Style="BaseButtonDark" Size="parent,parent">
        <Grid Size="90,46" Style="Grid9YieldBacking" Anchor="R,T" Offset="60,10">
          <Label ID="WarScore" Anchor="C,C" Style="GradientHeader" String="999" />
        </Grid>
        <Image Texture="QuestActive_Checkbox.dds" Size="64,64" Anchor="R,T" Offset="0,0" />
        <Image ID="CheckBoxDisabled" Texture="Checkbox_Gray.dds" Size="64,64" Anchor="R,T" Offset="0,0" />
        <Image ID="Check" Texture="QuestActive_Checkmark.dds" Size="64,64" Anchor="R,T" Offset="0,0" />
        <Label ID="Name" Style="WhiteShadow" FontSize="36" WrapWidth="400" Anchor="L,T" Offset="10,10" String="$CITY NAME HERE" />
        <Stack StackGrowth="Right" Anchor="L,B" Offset="0,10" Padding="10">
          <Label ID="Petroleum" Style="WhiteShadow" FontSize="36" String="[ICON_PETROLEUM]" />
          <Label ID="Geothermal" Style="WhiteShadow" FontSize="36" String="[ICON_GEOTHERMAL]" />
          <Label ID="Titanium" Style="WhiteShadow" FontSize="36" String="[TITANIUM]" />
