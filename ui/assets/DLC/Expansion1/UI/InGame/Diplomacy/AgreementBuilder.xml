<?xml version="1.0" encoding="utf-8"?>
<Context Colorset="Gray_Black_Alpha" Style="FontNormal16" FontStyle="Shadow" Layer="Modal">
  <Container ID="Content" Size="parent,parent" Anchor="C,T" Hidden="false">
    <Box Size="parent,parent" ConsumeMouse="true" Color="0,0,0,100" />
    <SlideAnim ID="SlideAnim" Anchor="C,C" Style="DiploTraitPopupSlideAnim">
      <AlphaAnim ID="AlphaAnim" Style="DiploAlphaAnim">
        <Grid Style="Grid9DetailFive140" Size="1500,1400" Anchor="C,C" Offset="0,0">
          <Label Style="FontNormal20" Anchor="C,T" Offset="0,20" String="$Agreement Builder$" />

          <Stack StackGrowth="Right" Anchor="C,T" Offset="0,80" Padding="20">
            <!-- Their policies content -->
            <Container Size="700,1300">
              <Stack StackGrowth="Bottom">
                <Label Style="FontNormal20" Anchor="C,C" String="$Their Foreign Policies$" />
                <Container Size="2,10" />

                <!-- Policies list -->
                <Box Size="700,1020" Color="0,0,0,50">
                  <ScrollPanel ID="ScrollPanel" Size="parent,parent" Vertical="1">
                    <ScrollBar Offset="-28,0" Style="VertSlider" Anchor="R,T" AnchorSide="O,I" />
                    <Stack ID="PoliciesStack" Size="parent,parent" StackGrowth="Bottom" />
                  </ScrollPanel>
                </Box>
              </Stack>
            </Container>
            
            <!-- Selected policy info -->
            <Container Size="700,1300">
              <Container ID="SelectedPolicyContent" Size="parent,parent">
                <Image ID="SelectedPolicy_Icon" Size="128,128" Anchor="C,T" Offset="0,0"/>
                <Label ID="SelectedPolicy_Name" Style="FontNormal24" Anchor="C,T" Offset="0,160" String="$Policy name here$" />
                <Label Style="FontNormal18" Anchor="C,T" Offset="0,230" String="$Perk$" />
                <Stack ID="SelectedPolicy_Stack" StackGrowth="Bottom" Anchor="C,T" Offset="0,270" Padding="20" />
              </Container>
            </Container>
          </Stack>
          <!-- Buttons -->
          <GridButton ID="CancelButton" Style="BaseButton" Anchor="C,B" Size="300,60" Offset="-200,20" String="$Cancel$" />
          <GridButton ID="ProposeButton" Style="BaseButton" Anchor="C,B" Size="300,60" Offset="200,20" String="$Propose$" />
        </Grid>
      </AlphaAnim>
    </SlideAnim>
  </Container>

  <!-- Instances -->
  <Instance Name="PolicyItem">
    <Container ID="Content" Size="670,170">
      <GridButton ID="Button" Style="GridListElementGray" Size="670,170" Offset="2,0">
        <Grid ID="SelectedHighlight" Style="GridListElementBlue" Size="parent,parent" Hidden="true" />
        <Image ID="Icon" Size="128,128" Anchor="L,T" Offset="20,20" />
        <Label ID="Name" Style="FontNormal20" Anchor="L,T" Offset="170,20" String="POLICY NAME HERE" />
        <Label ID="Description" Style="FontNormal16" Anchor="L,T" Offset="170,60" WrapWidth="500" String="DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD" />
        <Label ID="NoPolicy" Style="FontNormal20" Anchor="C,C" String="$No Policy$" Hidden="true"/>
      </GridButton>
    </Container>
  </Instance>
  
  <!-- Instances -->
  <Instance Name="PerkItem">
    <Container ID="Content" Size="parent,170">
      <Image ID="RelationshipIcon" Size="128,128" Anchor="L,C" Offset="0,-10"/>
      <Grid Style="Grid9DiploShadowedPanel" Size="parent-140,parent" Anchor="R,C">
        <Label ID="Description" Style="FontNormal16" Anchor="L,C" Offset="10,-10" WrapWidth="540" String="dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" />
        <Grid ID="Highlight" Style="Grid9DiploPanelHighlight" Anchor="C,C" Size="parent+10,parent" Offset="0,-8" />
      </Grid>
    </Container>
  </Instance>
</Context>