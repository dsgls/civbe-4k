<?xml version="1.0" encoding="utf-8"?>
<Context Colorset="Gray_Black_Alpha" Style="FontNormal16" FontStyle="Shadow" Layer="Modal">
  <Container ID="Content" Size="parent,parent" Anchor="C,T">
    <AlphaAnim AlphaBegin="0" AlphaEnd="1" Cycle="Once" Pause=".1" Function="Root" Speed="2" Size="parent,parent" ID="WindowAlpha">
      <SlideAnim Start="560,0" End="0,0" Cycle="Once" Pause="0" Function="OutQuint" Speed="2" Size="parent,parent" ID="WindowSlide">
        <Grid ID="MainWindowDropShadow" Style="Grid9DropShadow" Size="1980, parent-154" Offset="0,154" Anchor="C,T"/>
        <Grid ID="MainWindow" Style="Grid9DiplomacyWindow" Size="1800,parent-154" Offset="0,154" Anchor="C,T">
          <Container Offset="14,2" Size="1776,64">
            <Container Size="1776,64" Anchor="C,C">
              <Stack ID="HeaderStack" StackGrowth="Right" Anchor="L,C" Padding="10">
                <Container Size="66,56" Offset="0,4"/>
                <Label ID="WindowHeader" Anchor="L,C" Style="GradientHeader" String="{TXT_KEY_DIPLOMACYUI_MANAGETRAITS:upper}" />
              </Stack>
            </Container>
          </Container>
          <AlphaAnim Anchor="C,C" AlphaStart="0" AlphaEnd="1" Cycle="Once" Speed="3" Function="Root" ID="ManageTraitsAlpha">
            <SlideAnim Begin="-10,0" End="0,0" Cycle="Once" Speed="3" Function="Root" ID="ManageTraitsSlide">
              <Stack ID="TraitsStack" StackGrowth="Right" WrapGrowth="Bottom" WrapWidth="1800" Offset="0,20" Padding="30" Anchor="C,C"/>
            </SlideAnim>
          </AlphaAnim>
        </Grid>

        <AlphaAnim Anchor="C,T" Size="parent,parent" AlphaStart="0" AlphaEnd="1" Cycle="Once" Speed="2.5" Function="Root" ID="SelectTraitsAlpha" Stopped="1">
          <Grid ID="SwitchTraitDropShadow" Style="Grid9DropShadow" Size="1980, parent-154" Offset="0,154" Anchor="C,T"/>
          <SlideAnim Begin="0,50" Size="parent,parent" End="0,0" Cycle="Once" Speed="2.2" Function="Root" ID="SelectTraitsSlide" Stopped="1">
            <Grid ID="SwitchTraitWindow" Style="Grid9DiplomacyWindow" Size="1800,parent-154" Offset="0,154" Anchor="C,T">
              <Container Offset="14,2" Size="1776,64">
                <Container Size="1776,64" Anchor="C,C">
                  <Stack ID="SwitchTraitHeaderStack" StackGrowth="Right" Anchor="L,C" Padding="10">
                    <Container Size="66,56" Offset="0,4"/>
                    <Label ID="SwitchTraitHeader" Anchor="L,C" Style="GradientHeader" String="{TXT_KEY_DIPLOMACYUI_SELECTTRAIT:upper}" />
                    <AlphaAnim Anchor="L,C" Size="parent,parent" AlphaStart="0" AlphaEnd="1" Cycle="Once" Speed="3" Pause=".4" Function="Root" ID="IndicatorAlpha">
                      <SlideAnim Size="parent,parent" Begin="-20,0" End="0,0" Cycle="Once" Speed="3" Pause=".4" Function="Root" ID="IndicatorSlide">
                        <Stack ID="SelectTraitHeaderStack" StackGrowth="Right" Padding ="20">
                          <Image ID="SelectTraitIndicator" Texture="ManageTraits_SelectHeader.dds" Size="64,64" Hidden="1"/>
                          <Label ID="SelectTraitLabel" Anchor="L,C" Style="GradientSubHeader" String="Political Trait" Hidden="1"/>
                        </Stack>
                      </SlideAnim>
                    </AlphaAnim>
                  </Stack>
                  <AlphaAnim Size="parent,parent" AlphaStart="0" AlphaEnd="1" Cycle="Once" Pause=".3" Speed="3" Function="Root" ID="CancelAlpha">
                    <SlideAnim Size="parent,parent" Begin="-20,0" End="0,0" Cycle="Once" Pause=".3" Speed="3" Function="Root" ID="CancelSlide">
                      <GridButton TextAnchor="L,C" TextOffset="10" Anchor="R,T"  ID="CancelButton" Size="200,58" Style="ReturnButton" String="{TXT_KEY_CANCEL_BUTTON:upper}" Hidden="1"/>
                    </SlideAnim>
                  </AlphaAnim>
                </Container>
                <ScrollPanel ID="SelectTraitsPanel" Size="1780,parent-230" Offset="0,66" Anchor="L,T" Vertical="true" AutoScrollBar="1">
                  <ScrollBar ID="SelectTraitsScrollBar" Style="VertSlider" Anchor="R,T"/>
                  <Stack ID="ScrollPanelContentsStack" StackGrowth="Bottom" Anchor="C,T">
                    <Stack ID="SelectTraitsStack" StackGrowth="Right" WrapGrowth="Bottom" WrapWidth="1800" Padding="30" Anchor="C,T"/>
                    <Box ID="ScrollPanelPadding" Color="0,0,0,0" Size="1000,64"/>
                  </Stack>
                </ScrollPanel>
              </Container>
            </Grid>
          </SlideAnim>
          <Grid ID="ScrollPanelGradient" Style="Grid9BlackGradientSmall" Size="1780,128" Offset="0,8" Anchor="C,B" ConsumeMouse="0"/>
        </AlphaAnim>

        <Box ID="ConfirmSwap" Size="1800,parent-154" Offset="0,154" Anchor="C,T" ConsumeMouse="1" Color="0,0,0,200">
          <AlphaAnim Anchor="C,T" Size="parent,parent" AlphaStart="0" AlphaEnd="1" Cycle="Once" Speed="3" Function="Root" ID="ConfirmSwapAlpha">
            <SlideAnim Begin="0,-50" Size="parent,parent" End="0,0" Cycle="Once" Speed="3" Function="Root" ID="ConfirmSwapSlide">
              <Grid Style="Grid9DiplomacyWindow" Size="1800,1000" Anchor="C,C" Offset="0,40" ID="ConfirmSwapWindow">
                <Label ID="ConfirmSwapHeader" Style="GradientHeader" Anchor="C,T" Offset="0,16" String="{TXT_KEY_DIPLOMACYUI_CONFIRMTRAITSWAP:upper}" />
                <Stack StackGrowth="Down" Offset="0,100" Anchor="C,T" Padding="40" ID="WindowContentStack">
                  <Label ID="LoseUpgradesText" Anchor="C,T" FontStyle="glow" Color0="159,13,27,255" Color1="154,8,22,100" Style="FontNormal18" String="TXT_KEY_DIPLOMACYUI_LOSEUPGRADES" WrapWidth="1000"/>
                  <Stack StackGrowth="Right" Anchor="C,T" Padding="20" ID="TraitsInstanceStack">
                    <Container ID="OldTraitPlaceholder" Size="800,680" Anchor="L,C">
                        <Label String="{TXT_KEY_DIPLOMACYUI_CURRENTLYSELECTED:upper}" Style="GradientSubHeader" Anchor="C,B"/>
                    </Container>
                    <Image ID="Arrow" Texture="SwitchTrait_Arrow.dds" Size="78,74" Anchor="L,C" />
                    <Grid Style="Grid9HighlightBox" Size="820,680" Anchor="L,C" Offset="0,-10">
                      <Container ID="NewTraitPlaceholder" Size="800,680" Anchor="C,T" Offset="0,10">
                        <Label String="{TXT_KEY_DIPLOMACYUI_NEWSELECTION:upper}" Style="GradientHeader" Anchor="C,B" Offset="0,10"/>
                      </Container>
                    </Grid>
                  </Stack>
                  <Stack StackGrowth="Right" Anchor="C,T" Padding="20">
                    <GridButton ID="CancelSwapButton" Style="BaseButton" Size="500,64" String="{TXT_KEY_CANCEL_BUTTON:upper}" />
                    <GridButton ID="ConfirmSwapButton" Style="BaseButton" Size="500,64" String="{TXT_KEY_UNIT_UPGRADE_CONFIRM:upper}">
                      <Grid ID="ConfirmSwapCostContainer" Style="Grid9CostContainer" Size="140,80" Anchor="R,C">
                        <Stack ID="ConfirmSwapCostStack" StackGrowth="Right" Padding="4" Anchor="R,C" Offset="18,4" >
                          <Label ID="ConfirmSwapCost" Style="DiploCapitalText20" String="$$$"/>
                          <Label String="[ICON_DIPLO_CAPITAL]" Offset="0,6"/>
                        </Stack>
                      </Grid>
                    </GridButton>
                  </Stack>
                </Stack>
              </Grid>
            </SlideAnim>
          </AlphaAnim>
        </Box>

      </SlideAnim>
    </AlphaAnim>
  </Container>

  <Container Size="parent-120,80" Anchor="C,T" Offset="130,0">

    <SlideAnim Anchor="L,C" Start="0,0" End="0,80" Cycle="OneBounce" EndPause="2" Function="Root" Speed="2" Size="parent,parent" ID="DiploDeltaSlide" Stopped="1">
      <Grid Style="Grid9YieldBacking" Size="100,36" ID="DiploDeltaContainer" Color="255,255,255,200">
        <AlphaAnim AlphaStart=".4" AlphaEnd=".8" Cycle="Bounce" Speed="2" Size="parent,parent">
          <Label String="-24" Anchor="L,B" Offset="4,-2" Style="RedGlow20" ID="DiploDelta"/>
        </AlphaAnim>
      </Grid>
    </SlideAnim>

  </Container>

  <!-- Instances -->

  <!-- Perk Entry Instance -->
  <Instance Name="PersonalityTraitLevelEntry">
    <Grid ID="Content" Size="776,122" Anchor="R,T" Style="Grid9DiplomacyContainer">
      <GridButton ID="Button" Style="BaseButton" Size="parent,parent" />
      <Image ID="Icon" Size="132,90" Offset="0,0" Anchor="R,C" Texture="ManageTraits_Upgrade.dds"/>
      <Label ID="Description" Style="WhiteShadow" FontSize="28"  Anchor="L,C" Offset="10,0" WrapWidth="640" />
      <Grid ID="CostContainer" Style="Grid9CostContainer" Offset="-30,-40" Size="140,80" Anchor="R,T">
        <Stack ID="CostTextStack" StackGrowth="Right" Anchor="R,C" Offset="18,4" Padding="4" >
          <Label ID="UpgradeText" Style="UpgradeText16" String="{TXT_KEY_DIPLOMACYUI_UPGRADEFOR:upper}" Offset="0,4"/>
          <Label ID="Cost" Style="DiploCapitalText20" String="Cost here"/>
          <Label String="[ICON_DIPLO_CAPITAL]" Offset="0,6"/>
        </Stack>
      </Grid>
      <Box ID="Unavailable" Size="parent,parent" Color="0,0,0,100" />
    </Grid>
  </Instance>

