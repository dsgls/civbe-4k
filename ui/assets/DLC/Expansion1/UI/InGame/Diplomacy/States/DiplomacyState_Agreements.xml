                  <GridButton ID="AgreementsWithMeTab" Size="500,64" Offset="0,-6" Anchor="L,B" Style="TabInactive" String="{TXT_KEY_DIPLOMACYUI_AGREEMENTS_WITH_ME:upper}" ToolTip="{TXT_KEY_DIPLOMACYUI_AGREEMENTS_WITH_ME_TT}"/>
                </Grid>
                
                <!-- Capital Breakdown -->
                <Container Size="parent,360" Anchor="L,T" Offset="0,0">
                  <Container ID="HeaderContainer" Size="parent-260,270" Anchor="R,T" Offset="110,0">
                   
                      <!--Banked -->
                      <Grid Size="350,270" Anchor="L,T" Style="Grid9AgreementsContainer" Offset="0,0">
                        <Label Style="GradientSubHeader" Anchor="C,T" Offset="0,10" String="TXT_KEY_DIPLO_BANKEDNET" />
                        <Container Size="parent,parent-48" Anchor="C,T" Offset="0,48">
                          <Image Texture="Agreements_Circle.dds" Anchor="C,C" Size="184,184"/>
                          <Stack ID="CapitalStack" StackGrowth="Right" Anchor="C,C" Padding="20">
                            <Label ID="CapitalBanked" Style="DiploCapitalText36" String="99" />
                            <Label ID="CapitalNet" Style="DiploCapitalText36" String="-99" />
                          </Stack>
                          <Image Texture="Agreements_BigDiploCapital.dds" Anchor="L,C" AnchorSide="O,I" Offset="-20,0" Size="90,90"/>
                        </Container>
                      </Grid>
                    
                    <Stack ID="BreakdownStack" Anchor="R,T" StackGrowth="Right" Padding="24" Offset="0,0">
                      <!-- Income -->
                      <Grid Size="900,270" Anchor="C,T"  Style="Grid9AgreementsContainer" Offset="0,0">
                        <Label Style="GradientSubHeader" Anchor="C,T" Offset="0,10" String="TXT_KEY_DIPLOMACYUI_CAPITAL_INCOME" />
                        <Container Size="parent,parent-60" Anchor="C,B">
                          <Image Texture="Agreements_Circle.dds" Anchor="L,C" Size="184,184" Offset="20,0">
                            <Label ID="CapitalIncome" Style="DiploCapitalText36" Anchor="C,C" String="+99" Offset="-8,0"/>
                          </Image>
                          <Grid ID="SubIncomeContainer" Style="SubIncomeContainer" Size="parent-250,parent" Anchor="R,B">
                            <Stack StackGrowth="Left" Anchor="R,T">
                              <Container Size="220,110" Anchor="R,T">
                                <Label ID="CapitalFromServicesNumber" Style="DiploCapitalText36" Anchor="C,C" String="+0"/>
                              </Container>
                              <Label Offset="8,0" ID="CapitalFromServices" Style="DiploCapitalText20" Anchor="R,C" WrapWidth="470" String="INCOME FROM AGREEMENTS:" />
                            </Stack>
                            <Container Size="parent,parent" Anchor="L,C">
                              <Stack ID="IncomeAgreementsStack" StackGrowth="Right" Anchor="L,B" Offset="4,-14" />
                            </Container>
                          </Grid>
                        </Container>
                      </Grid>

                      <!-- Outgoing -->
                      <Grid ID="BreakdownOutgoing" Size="200,270" Anchor="R,T" Style="Grid9AgreementsContainer" Offset="0,0">
                        <Label Style="GradientSubHeader" Anchor="C,T" Offset="0,10" String="TXT_KEY_DIPLOMACYUI_CAPITAL_OUTGOING" />
                        <Container Size="parent,parent-48" Anchor="C,T" Offset="0,48">
                          <Image Texture="Agreements_Circle.dds" Anchor="C,C" Size="184,184">
                            <Label ID="CapitalOutgoing" Style="DiploCapitalText36" Anchor="C,C" String="-99" Offset="-8,0" />
                          </Image>
                        </Container>
                      </Grid>
                    </Stack>
                  </Container>
                  
                </Container>
                <!-- Cost Background Bar -->
                 <Box Anchor="R,B" Offset="110,0" Size="200,parent" Color="0,0,0,40"/>
                
                <!-- My Agreements -->
                <Container ID="MyAgreementsContent" Size="parent,parent-340" Offset="0,340">
                    <Stack Anchor="L,C" Offset="0,0" StackGrowth="Bottom" Padding="10" >
                      <Box Size="parent-80,180" Color="0,0,0,80" Anchor="C,T">
                        <Image Texture="Agreements_Numbers.dds" Size="120,112" Anchor="L,B" />
                      </Box>
                      <Box Size="parent-80,180" Color="0,0,0,80" Anchor="C,T">
                        <Image Texture="Agreements_Numbers.dds" Size="120,112" Anchor="L,B" TextureOffset="0,112"/>
                      </Box>
                      <Box Size="parent-80,180" Color="0,0,0,80" Anchor="C,T">
                        <Image Texture="Agreements_Numbers.dds" Size="120,112" Anchor="L,B" TextureOffset="0,224"/>
                      </Box>
                      <Box Size="parent-80,180" Color="0,0,0,80" Anchor="C,T">
                        <Image Texture="Agreements_Numbers.dds" Size="120,112" Anchor="L,B" TextureOffset="0,336"/>
                      </Box>
                      <Box Size="parent-80,180" Color="0,0,0,80" Anchor="C,T">
                        <Image Texture="Agreements_Numbers.dds" Size="120,112" Anchor="L,B" TextureOffset="0,448"/>
                      </Box>
                    </Stack>
                    <Container Anchor="C,C" Size="parent-80, 940">
                      <Stack ID="AgreementsStack"  Anchor="L,T" StackGrowth="Bottom" Padding="10" />
                    </Container>
                </Container>

                <!-- Agreements Made with Me -->
                <Container ID="AgreementsMadeWithMeContent" Size="parent,parent-340" Offset="0,340" Hide="true">
