            <Stack ID="BubbleContentStack" StackGrowth="Down" Anchor="L,T">
              <Grid ID="BubbleWindow" Style="Grid9DiplomacyWindow" Size="parent,parent">
                <Stack ID="MySpeechBubbleStack" Anchor="L,T" StackGrowth="Bottom" Padding="10" Offset="0,66">
                  <Container ID="MyProposePolicyContent" Size="parent,parent-66" >
                    <ScrollPanel Offset="10,0" ID="MyProposePolicyScrollPanel" Size="parent-50,parent-2" Vertical="true">
                      <ScrollBar Style="VertSlider" Anchor="R,T" AnchorSide="O,I" />
                      <Stack StackGrowth="Bottom" Anchor="C,T" Offset="0,0">
                        <Stack ID="MyProposePolicyStack" StackGrowth="Bottom" Padding="4" />
                        <Container Size="4,40"/>
                      </Stack>
                    </ScrollPanel>
                    <Grid ID="ScrollPanelGradient" Style="Grid9BlackGradientSmall" Size="parent-20,128" Offset="10,10" Anchor="L,B" ConsumeMouse="0"/>
                  </Container>
                </Stack>
              </Grid>
              <Container Size="4,20"/>
              <Container ID="MyProposedPolicyContent" Size="900,180" Anchor="C,T">
                <Label Style="DiplomacyColumnHeader" Anchor="L,T" Offset="70,0" String="TXT_KEY_DIPLOMACYUI_YOU_GET" />
                <Label Style="DiplomacyColumnHeader" Anchor="R,T" Offset="0,0" String="TXT_KEY_DIPLOMACYUI_COST" />
                <Container ID="MyProposedPolicyPlaceholder" Size="900,134" Anchor="C,B" />
              </Container>
              <Container Size="4,10"/>
              <Stack ID="ButtonStack" StackGrowth="Down" Padding="0" Anchor="C,T">
                <GridButton ID="OptionButton1" Style="DiploChoice" Size="parent,60" String="TXT_KEY_DIPLOMACYUI_NEVERMIND" Hidden="1"/>
                <GridButton ID="OptionButton2" Style="DiploChoice" Size="parent,60" String="TXT_KEY_DIPLOMACYUI_NEVERMIND" Hidden="1"/>
                <GridButton ID="OptionButton3" Style="DiploChoice" Size="parent,60" String="TXT_KEY_DIPLOMACYUI_NEVERMIND" Hidden="1"/>
              </Stack>
              <Container Size="4,24"/>
            </Stack>
          </Grid>
        </SlideAnim>
      </AlphaAnim>
    </Box>
  </Container>

  <Container ID="AgreementsOverviewContent" Size="parent,parent" >
