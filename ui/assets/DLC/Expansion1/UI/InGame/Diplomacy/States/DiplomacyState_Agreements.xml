              <Container Size="parent-20,parent-74" Anchor="C,B" Offset="0,10">

                <!-- Tabs -->
                <Grid ID="TabRow" Size="parent,72" Anchor="C,T" Offset="0,270" Style="CivilopediaSubHeader" Color="255,255,255,150">
