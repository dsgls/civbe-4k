            <Image ID="LeaderIcon" Anchor="C,C" Size="128,128" />
          </Image>
          <Image ID="RelationshipIndicator" Texture="PlayerRibbon_RelationshipIndicators.dds" Size="176,150" Hidden="0" Anchor="L,T" Offset="2,2" TextureOffset="100,0"/>
