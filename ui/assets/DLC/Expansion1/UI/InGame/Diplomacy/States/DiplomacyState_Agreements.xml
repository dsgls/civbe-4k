                <Stack Anchor="C,T" StackGrowth="right" Padding="0">
                  <GridButton ID="SortServicesBySponsor" Style="ColumnHeader" Anchor="C,C" Size="660,70" String="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_SPONSOR" ToolTip="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_SPONSOR_TT"/>
                  <GridButton ID="SortServicesByName" Style="ColumnHeader" Anchor="C,C" Size="600,70" String="TXT_KEY_DIPLO_NAME" ToolTip="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_NAME_TT"/>
                  <GridButton ID="SortServicesByCost" Style="ColumnHeader" Anchor="C,C" Size="200,70" String="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_COST" ToolTip="TXT_KEY_DIPLOMACYUI_SORT_SERVICES_BY_COST_TT"/>
                </Stack>
                <Container Size="parent,parent-70" Anchor="C,T" Offset="0,70"></Container>
                <ScrollPanel ID="AllServicesScrollPanel" Size="parent-240,parent-70" Offset="0,70" Vertical="true" Anchor="R,T">
