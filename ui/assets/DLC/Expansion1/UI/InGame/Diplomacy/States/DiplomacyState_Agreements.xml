        <Grid ID="AllServicesWindow" Style="Grid9DiplomacyWindow" Size="1800,parent-154" Offset="0,154" Anchor="C,T">
          <Container Offset="14,2" Size="1776,64">
            <Container Size="1776,64" Anchor="C,C">
              <Stack ID="AllServicesWindowHeaderStack" StackGrowth="Right" Anchor="L,C" Padding="10">
