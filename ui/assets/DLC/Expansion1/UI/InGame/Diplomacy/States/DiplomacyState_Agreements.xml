              <Grid Size="800,500" Anchor="C,C" Style="Grid9DropShadow">
                <Grid Size="750,450" Anchor="C,C" Style="Grid9DiplomacyWindow">
                  <Label Anchor="C,T" Offset="0,10" Style="GradientHeader" String="{TXT_KEY_DIPLOMACYUI_CONFIRM_HEADER:upper}" />
                  <Label Anchor="C,T" Offset="0,130" Style="FontNormal18" WrapWidth="700" Align="Center" String="TXT_KEY_DIPLOMACYUI_ARE_YOU_SURE_CANCEL_AGREEMENT" />
                  <Stack Anchor="C,B" StackGrowth="Right" Padding="30" Offset="0,30">
                    <GridButton ID="CancelAgreementNoButton" Style="BaseButton" Size="300,64" String="TXT_KEY_DIPLOMACYUI_NO" />
                    <GridButton ID="CancelAgreementYesButton" Style="BaseButton" Size="300,64" String="TXT_KEY_DIPLOMACYUI_YES" />
                  </Stack>
                </Grid>
              </Grid>
            </Box>
          </AlphaAnim>
        </Grid>
      </SlideAnim>
    </AlphaAnim>
  </Container>

  <!-- All Services Content -->
