<?xml version="1.0" encoding="utf-8"?>
<Context Colorset="Gray_Black_Alpha" Style="FontNormal16" FontStyle="Shadow" Layer="Modal">
  <Container ID="Content" Size="parent,parent" Anchor="C,T" Hidden="false">
    <Box Size="parent,parent" ConsumeMouse="true" Color="0,0,0,100" />
    <SlideAnim ID="SlideAnim" Anchor="C,C" Style="DiploTraitPopupSlideAnim">
      <AlphaAnim ID="AlphaAnim" Style="DiploAlphaAnim">
        <Grid Style="Grid9DetailFive140" Size="1400,1300" Anchor="C,C" Offset="0,0">
          <Stack ID="AgreementsStack" StackGrowth="Bottom" Padding="20"/>
          
          <!-- Buttons -->
          <GridButton ID="CancelButton" Style="BaseButton" Anchor="C,B" Size="300,60" Offset="0,-70" String="$Cancel$" />
        </Grid>
      </AlphaAnim>
    </SlideAnim>
  </Container>

  <!-- Instances -->
  <Instance Name="AgreementInstance">
    <Container ID="Content" Size="parent,400">
      <Box Size="parent-100,400" Anchor="L,B" Color="0,0,0,50" >
        <Box Size="200,parent" Color="0,0,0,100">
          <Image ID="MyPolicyIcon" Size="128,128" Anchor="C,T" Offset="0,20" />
          <Image ID="TheirPolicyIcon" Size="128,128" Anchor="C,B" Offset="0,20" />
        </Box>
        <Stack Offset="200,0" StackGrowth="Bottom">
          <Container Size="parent-200,200">
            <Label ID="MyPolicyName" Style="FontNormal20" Anchor="L,T" Offset="10,10" String="POLICY NAME HERE" />
            <Label ID="MyPolicyDescription" Style="FontNormal16" Anchor="L,T" Offset="10,60" String="Policy description here" />
          </Container>
          <Container Size="parent-200,200">
            <Label ID="TheirPolicyName" Style="FontNormal20" Anchor="L,T" Offset="10,10" String="POLICY NAME HERE" />
            <Label ID="TheirPolicyDescription" Style="FontNormal16" Anchor="L,T" Offset="10,60" String="Policy description here" />
          </Container>
        </Stack>
      </Box>
      <GridButton ID="CancelAgreementButton" Style="BaseButton" Size="100,100" Anchor="R,C" String="X" />
    </Container>
  </Instance>
</Context>