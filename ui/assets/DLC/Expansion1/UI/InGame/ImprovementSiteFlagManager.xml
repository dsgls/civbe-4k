<?xml version="1.0" encoding="utf-8"?>
<Context >

	<Container ID="ImprovementSiteFlags"/>

	<Instance Name="ImprovementSiteFlag">
		<WorldAnchor ID="Anchor">
			<Image ID="FlagShadow" Anchor="c,c" Size="128,128" TextureOffset="384,128" Texture="UnitFlagCiv.dds">

				<!-- Health Bar and backing -->
				<Image	ID="HealthBarBG"	Size="128,128"	Hidden="1"	TextureOffset="128,0"	Texture="UnitFlagCiv.dds"/>
				<Bar	ID="HealthBar"		Size="4,64"		Hidden="1"	Offset="104,32" Direction="Up" FGColor="0,255,255,255" BGColor="0,0,0,255" />

				<!-- Black Border & Actual flag -->
				<Image ID="FlagBaseOutline" Size="128,128"				TextureOffset="0,0"		Texture="UnitFlagCiv.dds"/>
				<Image ID="FlagBase"		Size="128,128"				TextureOffset="384,0"	Texture="UnitFlagCiv.dds"/>
				<Image ID="NormalSelect"	Size="128,128"	Hidden="1"	TextureOffset="0,256"	Texture="UnitFlagCiv.dds" />
				<Image ID="HealthBarSelect" Size="128,128"	Hidden="1"	TextureOffset="128,256"	Texture="UnitFlagCiv.dds"/>
				<Button ID="NormalButton"	Size="104,104" ConsumeMouseOver="1" NoDefaultSound="1">
					<ShowOnMouseOver>
						<AlphaAnim ID="NormalAlphaAnim" Size="128,128" TextureOffset="0,128" Texture="UnitFlagCiv.dds" Pause="0" Cycle="Bounce" Speed="1" AlphaStart=".99" AlphaEnd=".01"/>
						<ScrollAnim ID="NormalScrollAnim" Size="128,128" Speed=".5" Texture="UnitFlagShine.dds" MaskTexture="UnitFlagCivMask.dds"/>
					</ShowOnMouseOver>
				</Button>
				<Button ID="HealthBarButton" Size="104,104" ConsumeMouseOver="1" NoDefaultSound="1">
					<ShowOnMouseOver>
						<AlphaAnim ID="HealthBarAlphaAnim" Size="128,128" TextureOffset="128,128" Pause="0" Cycle="Bounce" Speed="1" AlphaStart=".99" AlphaEnd=".01" Texture="UnitFlagCiv.dds"/>
						<ScrollAnim ID="HealthBarScrollAnim" Size="128,128" Speed="-.50" Texture="UnitFlagShine.dds" MaskTexture="UnitFlagCivMask.dds"/>
					</ShowOnMouseOver>
				</Button>
				<!-- Lighting Effect -->
				<Image ID="LightEffect" TextureOffset="256,0" Texture="UnitFlagCiv.dds" Size="128,128" Hidden="0"/>
				<!-- Flag Icon -->
				<AlphaAnim ID="FlagIconAnim" Anchor="C,C" Size="90,90" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="0.95" AlphaEnd="0.25" Stopped="1">
					<Image ID="FlagIconShadow" Anchor="C,C" Size="90,90" Offset="0,0" Texture="UnitFlagCiv.dds" Color="0,0,0,128">
						<Image ID="FlagIcon" Anchor="C,C" Size="90,90" Offset="-2,-2" Texture="UnitFlagCiv.dds" Color="240,199,0,255" ToolTip=""/>
					</Image>
				</AlphaAnim>
			</Image>
		</WorldAnchor>
	</Instance>


	<Instance Name="SettlementFlag">
		<WorldAnchor ID="Anchor" Alpha="0.6">
			<Grid ID="SettlementBannerShadow" Anchor="C,C" AnchorSide="O,I" Size="280,128" Offset="0,40" Texture="CityBannerShadow.dds" SliceCorner="2,2" SliceSize="124,124" SliceTextureSize="128,128"/>
			<!-- BannerButton and hover highlighting-->
			<Button	ID="SettlementButton"				Anchor="C,C"					Size="320,80">				
				<Grid		ID="SettlementBannerButtonBase"		Anchor="C,C" AnchorSide="O,I"	Size="280,128"	Texture="CityBannerButtonBase.dds" SliceCorner="32,64" SliceSize="4,4" SliceTextureSize="64,128"/>
				<Image		ID="SettlementBannerButtonBaseLeft"	Anchor="L,C" AnchorSide="O,I"	Size="96,128"	Texture="CityBannerButtonBaseLeft.dds"/>
			</Button>

			<!-- BannerBackground -->
			<Grid			ID="SettlementBannerBackground"		Anchor="C,C" Offset="0,-2" Size="222,128" Texture="CityBannerBackground.dds" SliceCorner="32,64" SliceSize="2,2" SliceTextureSize="64,128">
				<Image		ID="SettlementBannerLeftBackground"		Offset="0,2" Anchor="L,C" AnchorSide="O,I"	Size="96,128" Color="PlayerColor2,180" Texture="CityBannerLeftBackground.dds">
					<Label	ID="Population"				Anchor="C,C" Offset="-6,2" Style="FontNormal20" ForceNonIME="1"/>
				</Image>
			</Grid>
			<!-- CityName -->
			<Box Anchor="C,C" Size="320,80" Color="0,0,0,0">
				<Stack ID="NameStack" Anchor="C,C" Offset="0,0" StackGrowth="Right" Padding="0">
					<Label ID="Name" Anchor="L,C" Offset="0,0" Style="FontNormal22" String="TXT_KEY_OBJECT_EARTHLING_SETTLEMENT"/>
				</Stack>
			</Box>

		</WorldAnchor>
	</Instance>

  <Instance Name="MinorMarvelFlag">
