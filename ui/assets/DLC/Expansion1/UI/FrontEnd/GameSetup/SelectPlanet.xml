	</GridButton>

  <Grid ID="CustomWorldPopup" Size="810,376" Anchor="C,C" Style="GridWindowWithSideBorders" ConsumeMouse="1" Hidden="1">
    <Label ID="PlanetLabel" Anchor="C,T" Offset="0,16" Style="FontNormal20" Color0="75,177,247" Color1="0,0,0,0" String="TXT_KEY_SELECT_PLANET" />
    <PullDown	ID="PlanetPull" Anchor="C,T" Offset="0,56" Style="GenericPullDown" ScrollThreshold="800" SpaceForScroll="0" Size="parent-32,64" />

    <Label ID="BiomeLabel" Anchor="C,T" Offset="0,136" Style="FontNormal20" Color0="75,177,247" Color1="0,0,0,0" String="TXT_KEY_SELECT BIOME" />
    <PullDown	ID="BiomePull" Anchor="C,T" Offset="0,176" Style="GenericPullDown" ScrollThreshold="800" SpaceForScroll="0" Size="parent-32,64" />

    <GridButton ID="CancelCustonButton" Anchor="L,B" Offset="16,16" Style="SmallButton" Size="320,76">
      <Label	  ID="CancelCustonLabel"	Anchor="C,C"  Offset="0,0"  String="TXT_KEY_CANCEL_BUTTON" Style="FontNormal18" ColorSet="Gray_Black_Alpha" FontStyle="Shadow" />
    </GridButton>
    <GridButton ID="AcceptCustonButton" Anchor="R,B" Offset="16,16" Style="SmallButton" Size="320,76">
      <Label	  ID="AcceptCustonLabel"	Anchor="C,C"  Offset="0,0"  String="TXT_KEY_ACCEPT_BUTTON" Style="FontNormal18" ColorSet="Gray_Black_Alpha" FontStyle="Shadow" />
    </GridButton>
  </Grid>

  <!--Instances ============================================== -->
  <Instance Name="ItemInstance">
    <Container    ID="Content"    Size="200,220">
      <GridButton ID="Button"     Size="Parent,Parent"	Style="GridSlotButtonGray"  />
      <Grid       ID="Highlight"  Size="Parent,Parent"	Style="GridSlotButtonBlue"  Hidden="1" />
      <Image      ID="Icon"       Size="128,128"			Anchor="L,C"	Offset="10,0"  />
      <Label      ID="Name"								Anchor="L,T"	Offset="160,30"	Style="FontNormal20" Color0="75,177,247" Color1="0,0,0,0" String="PLANET NAME HERE" />
      <Image      ID="CheckMark"  Size="64,64"			Anchor="R,B"	Offset="8,0"	Texture="Assets/UI/Art/Controls/QuestActive_CheckMark.dds" Hidden="1" />
      <Label      ID="MapTypeLabel"						Anchor="L,T"	Offset="160,72"	WrapWidth="600" Style="FontNormal16" Color0="166,230,75,255" Color1="0,0,0,0" String="MAP TYPE HERE"  />
      <Label      ID="DescriptionLabel"					Anchor="L,T"	Offset="160,108"	WrapWidth="600" Style="FontNormal16" ColorSet="Gray_Black_Alpha" FontStyle="Shadow" String="PLANET DESCRIPTION HERE"  />
    </Container>
  </Instance>

</Context>
