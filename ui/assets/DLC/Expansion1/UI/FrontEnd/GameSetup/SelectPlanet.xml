<?xml version="1.0" encoding="utf-8"?>
<Context  ColorSet="Beige_Black" Style="FontNormal22" FontStyle="Shadow" >

	<!--=================================================================== -->
	<!-- Select Planet                                                      -->
	<!--=================================================================== -->

  <GridButton ID="RescanButton" Anchor="L,T" Offset="170,220" Size="790,96" Style="GridListElementGray">
    <Label ID="RescanLabel" Anchor="L,C"	Offset="30,0"	Style="FontNormal20" Color0="75,177,247" Color1="0,0,0,0" String="TXT_KEY_SCAN_FOR_DIFFERNT_PLANETS" />
  </GridButton>
  
	<ScrollPanel		ID="ScrollPanel"	Anchor="L,T"	Offset="170,336" Size="810,1060"			Vertical="1" >
		<Stack				ID="Stack"				Anchor="L,T"	Offset="0,0"		Size="parent,parent" StackGrowth="Bottom" Padding="0"  />
    <ScrollBar											Anchor="R,T"	Offset="16,0"		Length="Parent"				Style="VertSlider" AnchorSide="I,I" />
	</ScrollPanel>    

	<GridButton ID="SelectButton" Anchor="L,B"  Style="SmallButton" Size="480,76"  Offset="328,64"  >
