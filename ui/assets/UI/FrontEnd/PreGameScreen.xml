            <Image  ID="SponsorTypeIcon"    Anchor="C,C"  Size="128,128"   Texture="GameSetupIconSheet.dds"  TextureOffset="256,0" />
            <Image  ID="SponsorIcon"        Anchor="C,C"  Size="128,128"   Hidden="1"/>
