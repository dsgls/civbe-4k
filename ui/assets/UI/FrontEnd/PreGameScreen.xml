            <Image  ID="ColonistsHighlight" Anchor="C,C"  Size="150,154"   Texture="Assets/UI/Art/GameSetup/CurrentSectionButtonHighlight.dds" />
            <Image  ID="ColonistsTypeIcon"  Anchor="C,C"  Size="128,128"   Texture="GameSetupIconSheet.dds"  TextureOffset="0,128" />
