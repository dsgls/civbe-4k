		<GridButton ID="AdvancedButton" Anchor="R,T"  Size="340,64" String="TXT_KEY_GAME_ADVANCED_SETUP" Style="SmallAdvButton" ConsumeMouse="1"/>		
	</Stack>
	


    <!-- Different sections menu -->
    <Image Anchor="R,B" Offset="0,60" Texture="SetupSectionsMenuBackground.dds" >
		
		<!-- The lines between the button options -->
        <Box		Anchor="R,T" Size="100,16" Offset="740,70"	Color="0,0,0,255">
			<Box	Anchor="C,C" Size="100,12"					Color="30,40,55,255" />
        </Box>		
        <Box		Anchor="R,T" Size="100,16" Offset="550,70"	Color="0,0,0,255">
			<Box	Anchor="C,C" Size="100,12"					Color="30,40,55,255" />
