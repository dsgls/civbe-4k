<?xml version="1.0" encoding="utf-8"?>
<Context  ColorSet="Beige_Black" Style="FontNormal22" FontStyle="Shadow"  >

	<Image			ID="Background"		Anchor="C,C" Size="Full,Full" StretchMode="UniformToFill" />	
