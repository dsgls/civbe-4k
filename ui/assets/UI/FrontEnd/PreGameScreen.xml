                <Label ID="SectionTitle" Anchor="L,C" Offset="20,4" Style="MenuTitleCaption" String="TXT_KEY_GAME_SELECTION_SCREEN" />
            </Box>

            <Grid   ID="SubPanel"  Anchor="L,T" Offset="0,112" Size="parent,1200" Color="255,255,255,255" Style="GridSetupGameSectionBackground" />   
        </Box>        
    </Box>
	
	<Box Size="Full,62" Anchor="L,B" Color="0,0,0,255" />	

	
