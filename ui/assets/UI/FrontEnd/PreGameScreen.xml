		<Box		Anchor="R,T" Size="100,16" Offset="360,70"	Color="0,0,0,255">
			<Box	Anchor="C,C" Size="100,12"					Color="30,40,55,255" />
        </Box>		
		<Box		Anchor="R,T" Size="100,16" Offset="170,70"		Color="0,0,0,255">
			<Box	Anchor="C,C" Size="100,12"					Color="30,40,55,255" />
        </Box>		
		
