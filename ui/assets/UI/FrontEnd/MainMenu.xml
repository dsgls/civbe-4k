<?xml version="1.0" encoding="utf-8"?>


<Context ColorSet="Gray_Black_Alpha" Style="FontNormal24" Name="MainMenu">

	<Image ID="CivBELogo" Style="MainGameLogo" /> 
  
	<Box Color="0,0,0,0" Offset="0,-50" Anchor="C,B" Size="480,480" Padding="0,0">
	
	  <AlphaAnim ID="FirstShowDelay" Pause="0.1" AlphaStart="0" AlphaEnd="0" Cycle="Once" />
		
    <Stack Anchor="C,T" StackGrowth="Down">
      <Box Size="280,35" Color="0,0,0,0">
        <SlideAnim Anchor="C,T" Size="280,35" Pause=".1" Start="60,0" End="0,0" Cycle="once" Speed="1.5" Function="OutQuint" ID="SinglePlayerSlide" >
          <AlphaAnim Anchor="C,T" Size="280,35" Pause=".1" Cycle="OneBounce" Speed="1" AlphaStart="0" AlphaEnd="1" ID="SinglePlayerAlpha">
            <Label Anchor="C,T" Style="FontTitle" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100" String="TXT_KEY_MODDING_SINGLE_PLAYER"/>
          </AlphaAnim>
        </SlideAnim>
      </Box>
      <Box Size="280,35" Color="0,0,0,0">
      <SlideAnim Anchor="C,T" Size="280,35" Pause=".3" Start="60,0" End="0,0" Cycle="once" Speed="1.5" Function="OutQuint" ID="MultiPlayerSlide">
        <AlphaAnim  Anchor="C,T" Size="280,35" Pause=".3" Cycle="OneBounce" Speed="1" AlphaStart="0" AlphaEnd="1" ID="MultiPlayerAlpha">
          <Label Anchor="C,T" Style="FontTitle" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100" String="TXT_KEY_MULTIPLAYER"/>
        </AlphaAnim>
      </SlideAnim>
      </Box>
      <Box Size="280,35" Color="0,0,0,0">
        <SlideAnim Anchor="C,T" Size="280,35" Pause=".5" Start="60,0" End="0,0" Cycle="once" Speed="1.5" Function="OutQuint" ID="ModsSlide">
          <AlphaAnim Anchor="C,T" Size="280,35" Pause=".5" Cycle="OneBounce" Speed="1" AlphaStart="0" AlphaEnd="1" ID="ModsAlpha">
            <Label Anchor="C,T" Style="FontTitle" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100" String="TXT_KEY_MODS"/>
          </AlphaAnim>
        </SlideAnim>
      </Box>
      <Box Size="280,35" Color="0,0,0,0">
        <SlideAnim Anchor="C,T" Size="280,35" Pause=".7" Start="60,0" End="0,0" Cycle="once" Speed="1.5" Function="OutQuint" ID="OptionsSlide">
          <AlphaAnim Anchor="C,T" Size="280,35" Pause=".7" Cycle="OneBounce" Speed="1" AlphaStart="0" AlphaEnd="1" ID="OptionsAlpha">
            <Label Anchor="C,T" Style="FontTitle" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100" String="TXT_KEY_OPTIONS"/>
          </AlphaAnim>
        </SlideAnim>
      </Box>
      <Box Size="280,35" Color="0,0,0,0">
        <SlideAnim Anchor="C,T" Size="280,35" Pause=".9" Start="60,0" End="0,0" Cycle="once" Speed="1.5" Function="OutQuint" ID="OtherSlide">
          <AlphaAnim Anchor="L,T" Size="280,35" Pause=".9" Cycle="OneBounce" Speed="1" AlphaStart="0" AlphaEnd="1" ID="OtherAlpha">
            <Label Anchor="C,T" Style="FontTitle" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100" String="TXT_KEY_OTHER"/>
          </AlphaAnim>
        </SlideAnim>
      </Box>
      <Box Size="280,35" Color="0,0,0,0">
        <SlideAnim Anchor="C,T" Size="280,35" Pause="1.1" Start="60,0" End="0,0" Cycle="once" Speed="1.5" Function="OutQuint" ID="DLCSlide">
          <AlphaAnim Anchor="L,T" Size="280,35" Pause="1.1" Cycle="OneBounce" Speed="1" AlphaStart="0" AlphaEnd="1" ID="DLCAlpha">
            <Label Anchor="C,T" Style="FontTitle" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100" String="TXT_KEY_LOAD_MENU_DLC"/>
          </AlphaAnim>
        </SlideAnim>
      </Box>
      <Box Size="280,35" Color="0,0,0,0">
        <SlideAnim Anchor="C,T" Size="280,35" Pause="1.3" Start="60,0" End="0,0" Cycle="once" Speed="1.5" Function="OutQuint" ID="ExitSlide">
          <AlphaAnim Anchor="L,T" Size="280,35" Pause="1.3" Cycle="OneBounce" Speed="1" AlphaStart="0" AlphaEnd="1" ID="ExitAlpha">
            <Label Anchor="C,T" Style="FontTitle" FontStyle="glow" Color0="182,203,228,255" Color1="182,203,228,100" String="TXT_KEY_EXIT_BUTTON"/>
          </AlphaAnim>
        </SlideAnim>
      </Box>
    </Stack>
      <AlphaAnim Anchor="C,B" Size="480,480" Pause="1.5" Cycle="once" Speed="1" AlphaStart="0" AlphaEnd=".8" ID="ButtonsFadeIn">
        <Stack Anchor="C,T" Offset="0,-10" StackGrowth="Down">
          <Button ID="SinglePlayerButton"	Size="280,35" Style="MainMenuButton" String="TXT_KEY_MODDING_SINGLE_PLAYER"/>
          <Button ID="MultiplayerButton"	Size="280,35" Style="MainMenuButton" String="TXT_KEY_MULTIPLAYER"/>
          <Button ID="ModsButton"			Size="280,35" Style="MainMenuButton" String="TXT_KEY_MODS"/>
          <Button ID="OptionsButton"		Size="280,35" Style="MainMenuButton" String="TXT_KEY_OPTIONS"/>
          <Button ID="OtherButton"			Size="280,35" Style="MainMenuButton" String="TXT_KEY_OTHER"/>
          <Button ID="DLCButton"      Size="280,35" Style="MainMenuButton" String="TXT_KEY_LOAD_MENU_DLC"/>
          <Button ID="ExitButton"			Size="280,35" Style="MainMenuButton" String="TXT_KEY_EXIT_BUTTON"/>
        </Stack>
      </AlphaAnim>
  </Box>

  <Button ID="My2KLogin" Disabled="true" Size="128,64" Anchor="R,B" Offset="5,5" Style="My2KLogoButton" />

  <!-- Message of the Day -->
  <Stack ID="MOTD_Stack" Hidden="1" Anchor="C,B" Offset="0,90" Size="750,120" StackGrowth="Bottom" Padding="12">
    <Box ID="MOTD_TitleBox" Color="0,0,0,0" Anchor="C,B" Size="700,28">
      <Image ID="MOTD_Title_Background" Anchor="C,T" Texture="MOTD.dds"/>
      <Label ID="MOTD_Title" Anchor="C,C" Style="MOTDTitle" String="TXT_KEY_MOTD" />
    </Box>
    <Label ID="MOTD_Message" Anchor="C,B" Style="MOTDMessage" WrapWidth="720" String="Some test, supposed to be good for you. I'm not gonna try it, YOU try it. I'm not gonna try it. Hey! Let's give it to Mikey. Yeah, he'll test it! He tests EVERYTHING!" />
  </Stack>

  <!-- Message / Driver Information  -->
  <AlphaAnim							Anchor="C,B" Offset="0,30" Cycle="Bounce" AlphaStart="1" AlphaEnd="0.6" Speed="2">
    <Label	ID="DriverNagMessage"	Hidden="1" 		Anchor="C,B" Offset="0,0" String="TXT_KEY_FRONTEND_DRIVERS_OUTDATED" ToolTip="TXT_KEY_FRONTEND_DRIVERS_OUTDATED_TT" Color0="255,128,0,255" Color1="255,255,255,96" FontStyle="Glow" Style="FontNormal14" />
  </AlphaAnim>

  <!-- Version Information  -->
  <Label	ID="VersionNumber"			Anchor="C,B" Offset="0,12" String="InvalidVersionNumber" Style="FontNormal16" />
  <Button	ID="TouchHelpButton"		Anchor="R,B" Offset="0,70" Size="128,128" TextureOffset="384,128" ToolTip="TXT_KEY_TOUCH_HELP" Texture="CivBE_TouchIconAtlas_128.dds" NoStateChange="1"  />
	
	
