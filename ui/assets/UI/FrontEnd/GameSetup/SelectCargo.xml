<?xml version="1.0" encoding="utf-8"?>
<Context  ColorSet="Beige_Black" Style="FontNormal22" FontStyle="Shadow" >

	<!--=================================================================== -->
	<!-- Select Cargo		                                                -->
	<!--=================================================================== -->
	<ScrollPanel Anchor="L,T" Offset="170,220" Size="810,1120" Vertical="1" ID="ScrollPanel" >
		<ScrollBar				Anchor="R,T"	Style="VertSlider" Length="Parent" Offset="16,0" AnchorSide="I,I" />
		<Stack		ID="Stack"	Anchor="L,T"	Offset="0,0" Size="810,Parent" StackGrowth="Bottom" Padding="0"  />
	</ScrollPanel>

	<Instance			Name="ItemInstance">
		<Container		ID="Content"							Size="790,180" >
			<GridButton ID="Button"								Size="Parent,Parent" Style="GridSlotButtonGray" />
			<Grid		ID="Highlight"							Size="Parent,Parent" Style="GridSlotButtonBlue"  />
			<Image		ID="Portrait"			Anchor="L,C"	Size="128,128" Offset="10,0" />
			<Label		ID="NameLabel"			Anchor="L,T"	Offset="160,30" Style="FontNormal20" Color0="75,177,247" Color1="0,0,0,0" String="NAME HERE" />
			<Label		ID="DescriptionLabel"	Anchor="L,T"	Offset="160,80" WrapWidth="600" Style="FontNormal16" ColorSet="Gray_Black_Alpha" FontStyle="Shadow" String="DESCRIPTION HERE" />
			<Image		ID="CheckMark"			Anchor="R,B"	Size="64,64" Offset="16,0" Texture="Assets/UI/Art/Controls/QuestActive_CheckMark.dds" />
		</Container>
	</Instance>

	<GridButton			ID="SelectButton"	Anchor="L,B"  Style="SmallButton" Size="480,76"  Offset="328,64"  >
		<Label								Anchor="C,C"  Offset="0,0"  String="{TXT_KEY_NEXT:upper}" Style="FontNormal18" ColorSet="Gray_Black_Alpha" FontStyle="Shadow" />
	</GridButton>

</Context>
