<?xml version="1.0" encoding="utf-8"?>
<Context ColorSet="Beige_Black_Alpha" FontSize="28" FontStyle="Shadow" Name="DebugPanel" >

		<LuaContext ID="DebugHotloadCache"		FileName="UI/DebugContext/DebugHotloadCache"/>
	
	
    <Stack ID="MainStack" Hidden="1" >
        
        <!-- Log Panel -->
        <Grid Style="SquareFrameBlue" Anchor="L,T" Size="1600,800" ID="LogGrid" Hidden="1" >
            <ScrollPanel Size="1540,780" Anchor="C,C" ID="LogScroll" Vertical="1" >
                <Stack StackGrowth="Bottom" Anchor="L,B" Offset="10,20" ID="LogStack" StackPadding="6" />

                <ScrollBar  Style="VertSlider"    Anchor="R,T" AnchorSide="O,I" Offset="-18,36" Length="708"  />
                <UpButton   Style="ScrollBarUp"   Anchor="R,T" AnchorSide="O,I" Offset="-20,0 "/>
                <DownButton Style="ScrollBarDown" Anchor="R,B" AnchorSide="O,I" Offset="-20,0 "/>
            </ScrollPanel>
        </Grid>


        <!-- Console Box and buttons -->
        <Grid Style="SquareFrameBlue" Anchor="L,T" Offset="120,0" Size="1480,60" ID="ConsoleGrid" >
            <ColorBox Color="0,0,0,90" Anchor="C,C" AutoSize="1" SizePadding="2,2" >
                <EditBox Anchor="C,C" Size="1460,40" MaxLength="255" ID="ConsoleEdit" />
            </ColorBox>
            <CheckBox Style="SquareCheck" Anchor="L,C" AnchorSide="o,i" ToolTip="Toggle Log" ID="LogCheck" />
            <CheckBox Style="SquareCheck" Anchor="L,C" AnchorSide="o,i" Offset="60,0" ToolTip="Toggle Panel" ID="SubPanelCheck" />
        </Grid>

        
        <!-- Sub Panels -->
        <Grid Style="SquareFrameBlue" Anchor="L,T" Size="400,100" ID="RadioGrid" Hidden="1" SizePadding="10,10" >

            <!-- RadioStack: Add radios to this thing -->
            <Stack StackPadding="0" Anchor="C,C" ID="RadioStack" />

            <!-- MuxContainer: Add panels to this thing -->
            <Container Anchor="R,T" AnchorSide="o,i" ID="PanelMux" />
        </Grid>
    </Stack>

	
	
		<!-- ========== INSTANCES ========== -->	
	
    <Instance Name="LogText" >
        <Label ID="Text" Anchor="l,c" WrapWidth="1540" Font="Cour.ttf" FontSize="28" />
    </Instance>
    
    <Instance Name="RadioInstance" >
        <RadioButton ID="Button" Anchor="R,C" RadioGroup="DebugPanelGroup" Style="SquareCheck" TextAnchor="L,C" TextAnchorSide="o,i" IsChecked="0" />
    </Instance>
	
	
</Context>
