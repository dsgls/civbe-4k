<?xml version="1.0" encoding="utf-8"?>
<Context ColorSet="Beige_Black_Alpha" FontStyle="SoftShadow" >

  <!-- Multiplayer Turn Queue Entry-->
  <Instance Name="TurnQueueEntry" >
    <Container ID="Root" Size="128,128" ConsumeMouse="1" Hidden="0">
      <AlphaAnim ID="ActiveTurnAnim" Anchor="C,C" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="1" AlphaEnd="0" >
        <Box		ID="CivIconFrame"	Size="128,128"	Anchor="C,C" Offset="0,0" Color="0,0,0,100">
          <Image	ID="CivIconBG"		Size="128,128"	Anchor="L,T" Offset="0,0" Texture="CivIconBGSizes.dds"/>
          <Image	ID="CivIcon"		Size="96,96"	Anchor="C,C" Offset="0,0" Texture="CivSymbolsColor512.dds"/>
          <Image	ID="CivIconHighlight"		Size="128,128"	Anchor="C,C" Offset="0,0" Texture="CivIconBGSizes_Highlight.dds"/>
        </Box>
      </AlphaAnim>
    </Container>
  </Instance>

  <Stack StackGrowth="Down" Anchor="C,T" Offset="0,60" ID="MultiplayerStack">

    <!-- Multiplayer Turn Queue Begin -->
    <Grid Anchor="C,C" Style="GridBlackIndent8" ID="TurnQueueGrid" Hidden="1">
      <Grid Style="GradientHeaderBlue" ID="TurnQueueGridFrame">
        <Stack StackGrowth="Right" WrapGrowth="Bottom" WrapWidth="1000" Anchor="C,C" Offset="0,0" ID="TurnQueueStack" />
      </Grid>
    </Grid>

    <!-- Multiplayer Turn Timer -->
    <Grid Anchor="C,T" Offset="0,0" Size="400,242" Style="GridBlackIndent8" ID="TurnTimeRoot">
      <Grid Style="CivilopediaHeader" Anchor="C,T" Size="400,80" Offset="0,-2">
        <Label Anchor="C,T" Offset="0,10" String="UnknownTime"  Style="GrayGlow" ID="TimerCountDown" />
      </Grid>
      <!-- Multiplayer Turn Timer Button-->
      <Button Anchor="C,T" AnchorSide="O,O" StateOffsetIncrement="0,0" Offset="0,-224" ToolTip="TXT_KEY_TURN_TIMER_ACTIVE_TT" Texture="assets\UI\Art\WorldView\TimerMeter.dds" Color="Black,164" Size="200,200" ID="EndTurnTimerButton" Hidden="0">
        <Image Anchor="C,T" Texture="assets\UI\Art\WorldView\TimerFrame.dds" Size="242,242" />
        <AlphaAnim Size="200,200" Pause="0" Offset="-2,20" Cycle="Bounce" Speed="1" AlphaStart=".8" AlphaEnd=".4">
          <Meter Size="200,200" Texture="assets\UI\Art\WorldView\TimerMeter.dds" HasShadow="1" Color="White.255" ShadowColor="0,0,0,100" ID="EndTurnTimeMeter" />
          <Meter Size="200,200" Texture="assets\DLC\Shared\TimerMeter_TurnEnded.dds" HasShadow="1" Color="White.255" ShadowColor="0,0,0,100" ID="EndTurnTimeMeter_TurnEnded" />
        </AlphaAnim>
        <AlphaAnim Anchor="C,C" Offset="-52,-30" ID="EndTurnTimerMyTurnAnim" Pause="0" Cycle="Bounce" Speed="1" AlphaStart="1" AlphaEnd=".4" Hidden="1">
          <Image Texture="assets\DLC\Shared\UI\Art\WorldView\TimerFrame_Center.dds" Size="102,102" />
        </AlphaAnim>
      </Button>
      
    </Grid>

  </Stack>
  
</Context>