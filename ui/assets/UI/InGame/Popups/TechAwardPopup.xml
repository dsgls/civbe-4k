<?xml version="1.0" encoding="utf-8"?>
<Context Layer="Modal" >

  <!--=======================================================================================================================-->
  <!--   Finished Researching a Tech...Popup  -->
  <!--=======================================================================================================================-->

  <Box Style="BGBlock" ID="BGBlock" />
  <AlphaAnim Size="Full,Full" Cycle="Once" Pause="0" Speed="2" AlphaStart="0" Function="OutQuint" AlphaEnd="1" ID="AlphaAnim">

    <Grid Size="1200, 1060"	Anchor="C,C" Offset="0,0"	Style="GridWindowWithHeader" ConsumeMouse="1" ID="OuterGrid" >
      <Label Style="MenuTitleCaption" 	Offset="0,34" Anchor="C,U" String="{TXT_KEY_TECH_AWARD_TITLE:upper}" ID="TitleLabel" />

      <!-- Image -->
      <Image ID="Banner" Size="1170,250" Anchor="C,T" Offset="0,96" Texture="Popup_Image_TechComplete.dds"/>

      <!--=======================================================================================================================-->
      <!-- Quote, Label, opened with the Tech -->
      <Stack ID="ContentStack" Anchor="C,T" Offset="0,380"   Size="0,0" StackGrowth="Bottom" Padding="0" >
        <Label Anchor="C,C"  Offset="0,0" Style="GrayGlow22" String="Technology Name" ID="TechName"/>
        <Box Anchor="C,C"  Offset="0,0"   Size="1000,36" Color="White.0" />
        <Image Anchor="C,C" Offset="0,0"  Color="255,255,255,150" Texture="bar500x2.dds" Size="1000.2" />
        <Box Anchor="C,C"  Offset="0,0"   Size="1000,28" Color="White.0" />
        <Label Anchor="C,C"  Offset="0,0"  WrapWidth="1120" Style="GrayGlow20" ID="TechQuote" String="DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD"/>
        <Container Size="10,20" />
        <Stack Anchor="C,C" Offset="0,0"   Size="0,0" StackGrowth="Right" Padding="-24" ID="BonusStack" >
          <Image Anchor="C,C" Texture="64x64FrameButtons.dds" Size="128,128" ID="B1_back">
            <Button NoStateChange="1" Anchor="C,C" Size="128,128"  ID="B1"/>
          </Image>
          <Image Anchor="C,C" Texture="64x64FrameButtons.dds" Size="128,128" ID="B2_back">
            <Button NoStateChange="1" Anchor="C,C" Size="128,128"  ID="B2"/>
          </Image>
            <Image Anchor="C,C" Texture="64x64FrameButtons.dds" Size="128,128" ID="B3_back">
            <Button NoStateChange="1" Anchor="C,C" Size="128,128"  ID="B3"/>
          </Image>
          <Image Anchor="C,C" Texture="64x64FrameButtons.dds" Size="128,128" ID="B4_back">
            <Button NoStateChange="1" Anchor="C,C" Size="128,128"  ID="B4"/>
          </Image>
          <Image Anchor="C,C" Texture="64x64FrameButtons.dds" Size="128,128" ID="B5_back">
            <Button NoStateChange="1" Anchor="C,C" Size="128,128"  ID="B5"/>
          </Image>
        </Stack>
        <Box Anchor="C,C"  Offset="0,0"   Size="1000,60" Color="White.0" />
        <Label Anchor="C,C"  Offset="0,0"  WrapWidth="1120"  Style="GrayGlow20" ID="TechHelp" String="DDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDDD"/>
        <Box Anchor="C,C"  Offset="0,0"   Size="1000,60" Color="White.0" />
      </Stack>

      <!--<Image Anchor="L,T" Offset="-5,45"  Texture="TechIconBacking.dds" Size="128,128">-->
      <Image Anchor="L,T" Offset="68,90"  Texture="TechIconBacking.dds" Size="256,256">
        <Image Texture="TechnologyAtlas1024.dds" Size="256,256" ID="TechIcon"/>
      </Image>

      <GridButton Anchor="C,B" Offset="0,40" Style="BaseButton" Size="440,70" StateOffsetIncrement="0,0" ID="ContinueButton" String="TXT_KEY_OK_BUTTON"/>
    </Grid>
  </AlphaAnim>
</Context>
