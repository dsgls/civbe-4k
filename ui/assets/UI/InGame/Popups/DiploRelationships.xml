<?xml version="1.0" encoding="utf-8"?>

<Context>
	
	<!-- Table Header (sortable via clicking) -->
	<Stack Anchor="L,T" StackGrowth="Right"		Offset="12,2" Padding="2">
		<GridButton		Style="BaseButton"		Anchor="L,C" Size="480,60">
			<Label		Style="TableHeaderText" String="{TXT_KEY_POPUP_CIVILIZATION:upper}" />
		</GridButton>
		<GridButton		Style="BaseButton"		Anchor="L,C" Size="160,60">
			<Label		Style="TableHeaderText" String="{TXT_KEY_POP_SCORE:upper}" />
		</GridButton>
		<GridButton		Style="BaseButton"		Anchor="C,C" Size="836,60" ID="GlobalPoliticsHeader">
			<Label		Style="TableHeaderText" String="{TXT_KEY_POPUP_GLOBAL_POLITICS:upper}" />
		</GridButton>	
	</Stack>
	
	<ScrollPanel	ID="MainScrollPanel" 	 Offset="12,52"	Size="1480,1040" AutoScrollBar="1" Vertical="1" >	
		<Stack		ID="MajorStack"			StackGrowth="Bottom" Padding="2" />			
		<ScrollBar							Anchor="R,T" Style="VertSlider" AnchorSide="I,I" Length="1040" />
	</ScrollPanel>
	
	<Instance Name="LeaderButtonInstance">
		<Button					ID="LeaderButton"	Anchor="L,T"		Size="parent,140" Offset="0,-4">
			<Stack				ID="LeaderStack"	Anchor="L,C"		StackGrowth="Right" Offset="-2,0" Padding="0"  ConsumeMouse="0">
				<GridButton		ID="NameBox"		Style="TableCell"	Size="484,190" >
					  <Box		ID="CivIconFrame"	Size="120,120"	Anchor="L,T" Offset="0,0" Color="0,0,0,100">
						<Image	ID="CivIconBG"		Size="128,128"	Anchor="L,T" Offset="-4,-4" Texture="CivIconBGSizes.dds"/>
						<Image	ID="CivIcon"		Size="96,96"	Anchor="C,C" Offset="0,0" Texture="CivSymbolsColor512.dds"/>
						<Image	ID="CivIconHighlight"		Size="128,128"	Anchor="C,C" Offset="0,0" Texture="CivIconBGSizes_Highlight.dds"/>
					  </Box>
					<Label		ID="LeaderName"		Anchor="L,T"		Offset="130,10"	Style="RelationshipCorp"						String="TXT_KEY_DIPLO_LEADER_NAME" />
					<Label		ID="CivName"		Anchor="L,T"		Offset="130,60"	Style="RelationshipCiv"		WrapWidth="360"		String="TXT_KEY_DIPLO_CIVILIZATION_NAME" />					
					<Label		ID="DiploState"		Anchor="L,T"		Offset="12,140"	Style="FontNormal18" ColorSet="Gray_Black_Alpha" FontStyle="Glow" String="" />
					<Label		ID="FavorsState"	Anchor="L,T"		Offset="12,140"	Style="FontNormal18" ColorSet="Gray_Black_Alpha" FontStyle="Shadow" String="" />
					<Label		ID="TeamID"			Anchor="L,T"		Offset="12,180"	Style="FontNormal18" ColorSet="Gray_Black_Alpha" FontStyle="Shadow" String="" />
				</GridButton>
				<GridButton		ID="ScoreBox"		Style="TableCell"	Size="164,100"	Offset="-2,0">
					<Label		ID="Score"			Anchor="C,T"		Style="FontNormal26" Offset="0,16" String="00" />
				</GridButton>
				<GridButton		ID="AffinitiesBox"		Style="TableCell"	Size="140,100"	Offset="-2,0">
					<Stack		ID="AffinitiesStack"	Anchor="L,T"		Padding="20"	Offset="0,20"/>
				</GridButton>				
				<GridButton		ID="PoliticsBox"	Style="TableCell"	Size="310,100"	Offset="-2,0">					
					<Stack		ID="PoliticsStack"	Anchor="L,T"		Padding="10"		Offset="0,10">
						<Label	ID="Favors"			Anchor="L,T"						Offset="8,0" Style="FontNormal16"  String="0 {TXT_KEY_DIPLO_FAVORS:upper}" />
						<Label	ID="WondersTitle"	Anchor="L,T"						Offset="8,0" Style="FontNormal16"  String="{TXT_KEY_DIPLO_WONDERS:upper}" />
					</Stack>										
				</GridButton>								
				<GridButton		ID="StatusBox"		Style="TableCell"	Size="394,100"	Offset="-2,0">
					<Stack		ID="StatusStack"	Anchor="R,T"		Padding="10"		Offset="0,10" />
				</GridButton>
			</Stack>
		</Button>
	</Instance>
	
	<Instance Name="AffinitiesLineInstance">
      <Box		ID="Box"			Align="C,T" Size="140,28" Color="255,255,255,0">
        <Label	ID="Label"			Offset="10,0" Color="200,200,230,255" Color1="0,0,0,0" Anchor="L,T" Style="FontNormal18" FontStyle="Shadow" String="0" />
      </Box>
    </Instance>
	
	<Instance Name="WondersLineInstance">
      <Box		ID="Box"			Align="L,T" Size="200,28" Color="255,255,255,0">
        <Label	ID="Label"			Offset="10,0" Color="150,150,150,255" Color1="0,0,0,0" Anchor="L,T" Style="FontNormal16" String="wonder line" />
      </Box>
    </Instance>
		
    <Instance Name="StatusLineInstance">
		<Container	ID="Box"						Align="L,T" Size="340,56" >
			<Label	ID="Label"		Offset="8,0"	Align="Left" WrapWidth="340" LeadingOffset="6" Color="105,150,72,255" Color1="0,0,0,0" Anchor="L,T" Style="FontNormal14" String="status line" />
		</Container>
    </Instance>

	
    <!-- War confrim pop-up -->
    <Grid Size="1000,720" Anchor="C,C" Offset="0,-160" ID="WarConfirm" Padding="0,40" Style="Grid9DetailFive140" ConsumeMouse="1" Hidden="1">

      <Label ID="Message" String="TXT_KEY_CONFIRM_WAR" Anchor="C,T" Offset="0,148" WrapWidth="880" Style="FontNormal22" ColorSet="Gray_Black_Alpha" FontStyle="Shadow"/>
      <Stack Anchor="C,B" Offset="0,160" Padding="48" StackGrowth="Bottom" ID="ButtonStack">

        <GridButton Style="BaseButton" ID="Yes" Size="740,84" Anchor="C,T" Offset="0,0" Hidden="0">
          <Label Anchor="C,C" Offset="0,0" String="TXT_KEY_YES_BUTTON" ColorSet="Gray_Black" Style="FontNormal24" FontStyle="Shadow"/>
        </GridButton>

        <GridButton Style="BaseButton" ID="No" Size="740,84" Anchor="C,T" Offset="0,0" Hidden="0">
          <Label Anchor="C,C" Offset="0,0" String="TXT_KEY_NO_BUTTON" ColorSet="Gray_Black" Style="FontNormal24" FontStyle="Shadow"/>
        </GridButton>
      </Stack>
    </Grid>
	
</Context>
