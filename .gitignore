/extracted

__pycache__/
*.pyc
.pytest_cache/

# Scratch documents that should never be committed.
/docs/tmp/

# Editor swap files.
*.swp

# reference/ holds copies of the stock UI trees, kept so the analysis is
# reproducible without a game install. Only the XML and Lua are tracked; the
# fonts, models, art and animations nothing reads are not.
/reference/**/*.ttf
/reference/**/*.gr2
/reference/**/*.ani
/reference/**/*.dds
/reference/**/*.png

# Upscaler checkpoints, downloaded on demand and hash-verified.
/civbe-upscale/models/

# ghidra-cli — ignore the binary project DB and runtime state.
ghidra-projects/*/logs
ghidra-projects/*/run
ghidra-projects/*/tmp
ghidra-projects/*/*.gpr
ghidra-projects/*/*.rep
ghidra-projects/*/*.lock*

result
